---
interface Props {
  size?: string;
  label?: string;
  tint?: string;
  spin?: boolean;
  depth?: number;
  className?: string;
}

const { size = "10rem", label = "", tint = "#c99a62", spin = true, depth = 1, className = "" } = Astro.props;
---

<div class={`box3d ${spin ? "is-spinning" : ""} ${className}`} style={`--s: ${size}; --kraft: ${tint}`} data-tilt={depth} aria-hidden="true">
  <div class="box3d-body">
    <span class="bf bf-front"><i class="tape"></i>{label && <b>{label}</b>}</span>
    <span class="bf bf-back"><i class="tape"></i></span>
    <span class="bf bf-right"></span>
    <span class="bf bf-left"></span>
    <span class="bf bf-top"><i class="tape tape-top"></i></span>
    <span class="bf bf-bottom"></span>
  </div>
</div>

<style>
  .box3d {
    --tx: 0deg;
    --ty: 0deg;
    width: var(--s);
    height: var(--s);
    perspective: 900px;
  }

  .box3d-body {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(calc(-22deg + var(--ty))) rotateY(calc(-32deg + var(--tx)));
  }

  .box3d.is-spinning .box3d-body {
    animation: box-spin 14s linear infinite;
  }

  @keyframes box-spin {
    to {
      transform: rotateX(calc(-22deg + var(--ty))) rotateY(calc(328deg + var(--tx)));
    }
  }

  .bf {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.03) 0 2px, transparent 2px 7px),
      linear-gradient(160deg, color-mix(in srgb, var(--kraft) 85%, #fff), var(--kraft));
    border: 1px solid color-mix(in srgb, var(--kraft) 70%, #000);
    backface-visibility: hidden;
  }

  .bf-front {
    transform: translateZ(calc(var(--s) / 2));
  }

  .bf-back {
    transform: rotateY(180deg) translateZ(calc(var(--s) / 2));
  }

  .bf-right {
    transform: rotateY(90deg) translateZ(calc(var(--s) / 2));
    filter: brightness(0.86);
  }

  .bf-left {
    transform: rotateY(-90deg) translateZ(calc(var(--s) / 2));
    filter: brightness(0.86);
  }

  .bf-top {
    transform: rotateX(90deg) translateZ(calc(var(--s) / 2));
    filter: brightness(1.08);
  }

  .bf-bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--s) / 2));
    filter: brightness(0.7);
  }

  .tape {
    position: absolute;
    top: 0;
    left: 50%;
    width: 22%;
    height: 34%;
    background: rgba(255, 244, 214, 0.55);
    transform: translateX(-50%);
  }

  .tape-top {
    height: 100%;
  }

  .bf b {
    position: relative;
    padding: 0.2em 0.5em;
    border: 2px solid rgba(40, 24, 10, 0.75);
    color: rgba(40, 24, 10, 0.85);
    font-family: var(--font-display);
    font-size: calc(var(--s) * 0.12);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    rotate: -6deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .box3d.is-spinning .box3d-body {
      animation: none;
    }
  }
</style>
