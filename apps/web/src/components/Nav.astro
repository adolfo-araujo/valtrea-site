---
import { quoteMailto } from "../config/company";
import { dictionaryFor, homePathFor, type Locale } from "../i18n";
import Logo from "./Logo.astro";

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  locale: Locale;
  links?: NavLink[] | undefined;
  cta?: NavLink | undefined;
  otherLanguageHref?: string | undefined;
}

const { locale } = Astro.props;
const t = dictionaryFor(locale);
const otherLocale: Locale = locale === "pt" ? "en" : "pt";
const links = Astro.props.links ?? [
  { href: "#install", label: t.nav.install },
  { href: "#coffee", label: t.nav.coffee },
  { href: "#privacy", label: t.nav.privacy },
  { href: "#faq", label: t.nav.faq },
];
const cta = Astro.props.cta ?? { href: quoteMailto(t.hero.mailSubject), label: t.nav.cta };
const otherLanguageHref = Astro.props.otherLanguageHref ?? homePathFor(otherLocale);
---

<header class="nav" data-nav>
  <div class="nav-inner container">
    <a class="nav-brand" href={homePathFor(locale)} aria-label="Valtrea"><Logo /></a>
    <nav class="nav-links" aria-label={t.nav.label}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="nav-language" href={otherLanguageHref} hreflang={otherLocale === "pt" ? "pt-BR" : "en"} aria-label={t.nav.switchLanguageLabel}>
        {t.nav.switchLanguage}
      </a>
      <a class="nav-cta liquid-glass" href={cta.href}>{cta.label}</a>
      <details class="nav-menu">
        <summary class="liquid-glass" aria-label={t.site.nav.menu}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div class="nav-menu-panel glass-plate">
          {links.map((link) => <a href={link.href} data-menu-link>{link.label}</a>)}
          <a href={otherLanguageHref} hreflang={otherLocale === "pt" ? "pt-BR" : "en"} data-menu-link>{t.nav.switchLanguage}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      background 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .nav.is-scrolled {
    background: rgba(243, 244, 246, 0.78);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    box-shadow: 0 1px 0 var(--line);
  }

  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.25rem;
  }

  .nav-brand {
    text-decoration: none;
  }

  .nav-links {
    display: none;
    gap: 0.35rem;
    font-size: 0.93rem;
  }

  .nav-links a {
    position: relative;
    z-index: 1;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
  }

  .nav-inner :global(.nav-pill) {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: 999px;
    background: var(--lg-fill-hover);
    border: 1px solid rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(4px) saturate(1.3);
    -webkit-backdrop-filter: blur(4px) saturate(1.3);
    box-shadow: var(--lg-shadow);
    transition:
      transform 0.55s cubic-bezier(0.3, 1.25, 0.45, 1),
      width 0.55s cubic-bezier(0.3, 1.25, 0.45, 1);
    pointer-events: none;
  }

  .nav.has-pill .nav-cta,
  .nav.has-pill .nav-cta:hover {
    position: relative;
    z-index: 1;
    background: none;
    border-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .nav-links a,
  .nav-language {
    color: var(--text-soft);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .nav-links a:hover,
  .nav-language:hover {
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.93rem;
  }

  .nav-cta {
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  .nav-menu {
    position: relative;
  }

  .nav-menu summary {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    list-style: none;
    cursor: pointer;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    display: grid;
    min-width: 13rem;
    padding: 0.5rem;
  }

  .nav-menu-panel a {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .nav-menu-panel a:hover {
    background: rgba(var(--brand-rgb), 0.08);
  }

  .nav-language {
    display: none;
  }

  @media (max-width: 420px) {
    .nav-cta {
      padding-inline: 0.85rem;
      font-size: 0.85rem;
    }
  }

  @media (min-width: 900px) {
    .nav-links,
    .nav-language {
      display: flex;
    }

    .nav-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav-inner :global(.nav-pill) {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((link) => {
    link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
  });
</script>
