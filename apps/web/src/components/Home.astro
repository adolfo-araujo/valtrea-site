---
import type { Locale } from "../i18n";
import Layout from "../layouts/Layout.astro";
import CoffeeSection from "./CoffeeSection.astro";
import Faq from "./Faq.astro";
import Features from "./Features.astro";
import Footer from "./Footer.astro";
import Hero from "./Hero.astro";
import Install from "./Install.astro";
import Backdrop from "./site/Backdrop.astro";
import SiteNav from "./site/SiteNav.astro";
import Privacy from "./Privacy.astro";
import ChatWidget from "./site/ChatWidget.astro";

interface Props {
  locale: Locale;
  path?: string | undefined;
  otherLanguageHref?: string | undefined;
}

const { locale, path, otherLanguageHref } = Astro.props;
---

<Layout locale={locale} path={path} alternates={{ pt: "/produtos", en: "/en/products" }} bodyClass="has-backdrop">
  <Backdrop dots={false} />
  <SiteNav locale={locale} otherLanguageHref={otherLanguageHref ?? (locale === "pt" ? "/en/products" : "/produtos")} />
  <main id="main" class="site-main">
    <Hero locale={locale} />
    <Features locale={locale} />
    <Install locale={locale} />
    <CoffeeSection locale={locale} />
    <Privacy locale={locale} />
    <Faq locale={locale} />
  </main>
  <Footer locale={locale} />
  <ChatWidget locale={locale} />
</Layout>
