---
import { company, hasWhatsapp } from "../../config/company";
import { legalPath } from "../../config/legal";
import { sitePaths } from "../../config/paths";
import { dictionaryFor, type Locale } from "../../i18n";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = dictionaryFor(locale).site;
const person = company.person;
const chat = s.chat;
const data = {
  answers: s.answers,
  fallback: s.fallback,
  askAgain: s.askAgain,
  greeting: chat.notices.map((line) => line.replace("{name}", person.name)),
  continueLabel: hasWhatsapp() ? chat.continue : chat.continueEmail,
  whatsapp: hasWhatsapp() ? company.whatsapp : "",
  email: company.email,
  subject: s.contact.subject,
  hours: company.hours,
  online: chat.online,
  offline: chat.offline.replace("{hour}", String(company.hours.opens)),
  typing: chat.typing,
  locale: locale === "pt" ? "pt-BR" : "en-US",
  flow: {
    notices: chat.notices.map((line) => line.replace("{name}", person.name)),
    kind: chat.kind,
    goal: chat.goal,
    deadline: chat.deadline,
    nameQuestion: chat.nameQuestion,
    final: chat.final,
    message: chat.message.replace("{person}", person.name),
    example: chat.example,
    yourName: chat.yourName,
    yourAnswer: chat.yourAnswer,
    placeholder: chat.placeholder,
    send: chat.send,
    cta: chat.continue,
    alt: chat.alt,
    altHref: sitePaths(locale).contact,
    privacy: locale === "pt" ? "Seus dados só servem para responder ao seu contato. Política de Privacidade" : "Your data is only used to reply to you. Privacy Policy",
    privacyHref: legalPath(locale, "privacy"),
  },
};
---

<script is:inline type="application/json" id="site-chat-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

<form class="talk-bar" data-talk>
  <label class="sr-only" for="talk-input">{chat.talkLabel}</label>
  <input id="talk-input" type="text" autocomplete="off" maxlength="500" placeholder={chat.talkPlaceholder} />
  <button type="submit" class="talk-send" aria-label={chat.talkSend}><Icon name="up" size={18} /></button>
</form>

<div class="cb-fab-wrap" data-chat-fab-wrap>
  <p class="cb-preview" data-chat-preview aria-hidden="true"></p>
  <button type="button" class="cb-fab" data-chat-fab aria-label={chat.open} aria-expanded="false" aria-controls="chat-box">
    <Icon name="chat" size={24} />
    <span class="cb-badge" data-chat-badge aria-hidden="true"></span>
  </button>
</div>

<section class="cb-box" id="chat-box" data-chat-box aria-label={`${person.name} · ${company.name}`} hidden>
  <header class="cb-head">
    <span class="cb-avatar" aria-hidden="true">
      {person.photo ? <img src={person.photo} alt="" width="38" height="38" /> : person.name.charAt(0)}
    </span>
    <div>
      <b>{person.name}</b>
      <small><i data-chat-dot></i> <span data-chat-status>{chat.online}</span></small>
    </div>
    <button type="button" class="cb-close" data-chat-close aria-label={chat.close}><Icon name="close" size={18} /></button>
  </header>
  <div class="cb-log" role="log" aria-live="polite" data-chat-log></div>
  <div class="cb-foot" data-chat-foot></div>
</section>

<style is:global>
  .chat-log {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chat-bubble {
    position: relative;
    max-width: 82%;
    padding: 0.6rem 0.85rem 0.45rem;
    border-radius: 18px;
    font-size: 0.97rem;
    line-height: 1.45;
    animation: chat-pop 0.3s var(--ease) both;
  }

  .chat-bubble p {
    margin: 0;
  }

  .chat-bubble--bot {
    justify-self: start;
    background: #fff;
    border-bottom-left-radius: 6px;
    box-shadow: 0 1px 1px rgba(17, 17, 22, 0.06), 0 0 0 1px rgba(17, 17, 22, 0.05);
  }

  .chat-bubble--me {
    justify-self: end;
    background: #d9f5c8;
    color: #10230a;
    border-bottom-right-radius: 6px;
    box-shadow: 0 1px 1px rgba(17, 17, 22, 0.06);
  }

  .chat-meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.2rem;
    margin-top: 0.15rem;
    color: rgba(17, 17, 22, 0.45);
    font-size: 0.7rem;
  }

  .chat-ticks {
    color: #34b7f1;
  }

  .chat-link {
    display: inline-flex;
    margin-top: 0.45rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
  }

  .chat-link:hover {
    background: var(--brand-deep);
  }

  .chat-typing {
    display: flex;
    gap: 0.25rem;
    padding: 0.8rem 0.95rem;
  }

  .chat-typing span {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--text-mute);
    animation: chat-dots 1s infinite ease-in-out;
  }

  .chat-typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .chat-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes chat-pop {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }

  @keyframes chat-dots {
    0%,
    80%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  .talk-bar {
    position: fixed;
    left: 50%;
    bottom: 1.1rem;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: min(26rem, calc(100% - 7.5rem));
    padding: 0.35rem 0.35rem 0.35rem 1.1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow: var(--lg-shadow), 0 16px 34px -20px rgba(17, 17, 22, 0.4);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 1rem);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .talk-bar.is-shown {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .chat-is-open .talk-bar {
    opacity: 0;
    pointer-events: none;
  }

  .talk-bar input,
  .chat-form input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    outline: none;
  }

  .talk-bar:focus-within,
  .chat-form:focus-within {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .talk-send,
  .round-send {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 50%;
    background: var(--text);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s var(--ease);
  }

  .talk-send:hover,
  .round-send:hover {
    background: var(--brand);
  }

  .cb-fab-wrap {
    position: fixed;
    right: 20px;
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    z-index: 92;
    display: flex;
    align-items: center;
    gap: 10px;
    pointer-events: none;
  }

  .cb-fab {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 0;
    border-radius: 50%;
    background: #111116;
    color: #fff;
    box-shadow: 0 14px 30px -12px rgba(17, 17, 22, 0.55);
    cursor: pointer;
    pointer-events: auto;
    transform: scale(0);
    transition: background-color 0.2s;
  }

  .cb-fab:hover {
    background: #2a2a33;
  }

  .cb-fab-wrap.is-on .cb-fab {
    transform: none;
    animation: cb-pop 0.8s ease-in-out backwards;
  }

  .cb-fab-wrap.is-open .cb-fab svg {
    transform: scale(0.9);
  }

  .cb-badge {
    position: absolute;
    top: -3px;
    right: -3px;
    min-width: 21px;
    height: 21px;
    padding: 0 6px;
    border-radius: 999px;
    background: #d92d20;
    box-shadow: 0 0 0 2px #fff;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 21px;
    text-align: center;
    transform: scale(0);
  }

  .cb-fab-wrap.has-badge .cb-badge {
    transform: none;
  }

  .cb-badge.is-pop {
    animation: cb-pop 0.6s ease-in-out backwards;
  }

  .cb-preview {
    order: -1;
    max-width: 250px;
    margin: 0;
    padding: 11px 15px;
    border-radius: 18px 18px 6px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow:
      0 0 0 0.5px rgba(17, 17, 22, 0.14),
      inset 0 1px 0 #fff,
      0 14px 30px -14px rgba(17, 17, 22, 0.35);
    color: var(--text);
    font-size: 13.5px;
    line-height: 1.4;
    cursor: pointer;
    opacity: 0;
    transform: translateX(10px) scale(0.9);
    transform-origin: 100% 100%;
    backdrop-filter: blur(8px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.5s cubic-bezier(0.3, 1.4, 0.45, 1);
  }

  .cb-fab-wrap.has-preview:not(.is-open) .cb-preview {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .cb-box {
    position: fixed;
    right: 20px;
    bottom: calc(90px + env(safe-area-inset-bottom, 0px));
    z-index: 96;
    display: flex;
    flex-direction: column;
    width: 380px;
    height: min(580px, 100vh - 130px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 26px;
    background:
      radial-gradient(80% 70% at 50% 40%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 70%),
      linear-gradient(170deg, #f7f7ff 0%, #ebecfd 55%, #dfe2fb 100%);
    box-shadow:
      -1px 0 0 rgba(17, 17, 22, 0.22),
      1px 0 0 rgba(17, 17, 22, 0.22),
      0 0 0 0.5px rgba(17, 17, 22, 0.14),
      inset 0 1px 0 #fff,
      0 30px 70px -30px rgba(17, 17, 22, 0.45);
    backdrop-filter: blur(14px) saturate(1.4);
    transform-origin: 100% 100%;
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
    transition:
      opacity 0.2s var(--ease),
      transform 0.25s var(--ease);
  }

  .cb-box[hidden] {
    display: none;
  }

  .cb-box.is-open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition:
      opacity 0.25s var(--ease),
      transform 0.6s cubic-bezier(0.3, 1.3, 0.45, 1);
  }

  .cb-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 14px 12px 18px;
    border-bottom: 1px solid rgba(17, 17, 22, 0.07);
  }

  .cb-head div {
    flex: 1;
    line-height: 1.25;
  }

  .cb-head b {
    display: block;
    font-size: 15px;
  }

  .cb-head small {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-soft);
    font-size: 12px;
  }

  .cb-head small i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2ecc71;
    box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.18);
  }

  .cb-head small i.is-away {
    background: #a3a6ad;
    box-shadow: 0 0 0 3px rgba(163, 166, 173, 0.2);
  }

  .cb-avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    overflow: hidden;
    border-radius: 50%;
    background: linear-gradient(150deg, #2a2a33, #111116);
    color: #fff;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
  }

  .cb-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cb-close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--text-soft);
    cursor: pointer;
  }

  .cb-close:hover {
    background: rgba(17, 17, 22, 0.06);
    color: var(--text);
  }

  .cb-log {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 18px 16px 10px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cb-msg {
    max-width: 84%;
    margin: 0;
    padding: 10px 14px;
    font-size: 14px;
    line-height: 1.45;
    white-space: pre-wrap;
    animation: cb-in 0.35s cubic-bezier(0.3, 1.3, 0.45, 1) backwards;
  }

  .cb-msg--bot {
    align-self: flex-start;
    border-radius: 18px 18px 18px 6px;
    background: #fff;
    box-shadow:
      0 0 0 0.5px rgba(17, 17, 22, 0.1),
      0 4px 12px -8px rgba(17, 17, 22, 0.3);
    color: var(--text);
    transform-origin: 0 100%;
  }

  .cb-msg--me {
    align-self: flex-end;
    border-radius: 18px 18px 6px;
    background: #111116;
    color: #fff;
    transform-origin: 100% 100%;
  }

  .cb-typing {
    display: inline-flex;
    gap: 4px;
    padding: 14px 16px;
  }

  .cb-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(17, 17, 22, 0.4);
    animation: cb-typing 1s ease-in-out infinite;
  }

  .cb-typing i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .cb-typing i:nth-child(3) {
    animation-delay: 0.3s;
  }

  .cb-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    padding: 10px 14px 16px;
  }

  .cb-foot:empty {
    display: none;
  }

  .cb-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .cb-chip {
    padding: 8px 15px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    background: radial-gradient(ellipse 65% 95% at 50% 50%, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.55) 60%, rgba(255, 255, 255, 0.3) 100%);
    box-shadow:
      -1px 0 0 rgba(17, 17, 22, 0.32),
      1px 0 0 rgba(17, 17, 22, 0.32),
      0 0 0 0.5px rgba(17, 17, 22, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.75);
    color: var(--text);
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
    animation: cb-in 0.35s cubic-bezier(0.3, 1.3, 0.45, 1) backwards;
  }

  .cb-chip:hover {
    background: radial-gradient(ellipse 70% 100% at 50% 50%, #fff 0%, rgba(255, 255, 255, 0.7) 60%, rgba(255, 255, 255, 0.4) 100%);
  }

  .cb-chip:nth-child(2) {
    animation-delay: 0.04s;
  }

  .cb-chip:nth-child(3) {
    animation-delay: 0.08s;
  }

  .cb-chip:nth-child(4) {
    animation-delay: 0.12s;
  }

  .cb-chip:nth-child(5) {
    animation-delay: 0.16s;
  }

  .cb-chip:nth-child(6) {
    animation-delay: 0.2s;
  }

  .cb-chip:nth-child(7) {
    animation-delay: 0.24s;
  }

  .cb-chip:nth-child(8) {
    animation-delay: 0.28s;
  }

  .cb-input {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    height: 48px;
    padding: 0 5px 0 18px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    background: radial-gradient(ellipse 65% 95% at 50% 50%, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.55) 60%, rgba(255, 255, 255, 0.35) 100%);
    box-shadow:
      -1px 0 0 rgba(17, 17, 22, 0.32),
      1px 0 0 rgba(17, 17, 22, 0.32),
      0 0 0 0.5px rgba(17, 17, 22, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.75);
    color: var(--text);
    font: inherit;
  }

  .cb-input input {
    flex: 1;
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 16px;
  }

  .cb-input button,
  .cb-input i {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: #111116;
    color: #fff;
    cursor: pointer;
  }

  .cb-input--fake {
    justify-content: space-between;
    color: var(--text-soft);
    font-size: 15px;
    text-align: left;
    cursor: text;
  }

  .cb-input--fake i {
    background: rgba(17, 17, 22, 0.25);
  }

  .cb-cta {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 52px;
    padding: 0.8rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    background: radial-gradient(ellipse 70% 100% at 50% 50%, #fff 0%, rgba(255, 255, 255, 0.75) 60%, rgba(255, 255, 255, 0.45) 100%);
    box-shadow:
      -1px 0 0 rgba(17, 17, 22, 0.32),
      1px 0 0 rgba(17, 17, 22, 0.32),
      0 0 0 0.5px rgba(17, 17, 22, 0.16),
      inset 0 1px 0 #fff;
    color: var(--brand);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .cb-cta:hover {
    color: var(--brand-deep);
  }

  .cb-alt {
    justify-self: center;
    color: var(--text-soft);
    font-size: 13px;
    text-underline-offset: 3px;
  }

  .cb-privacy {
    justify-self: center;
    max-width: 18rem;
    color: var(--text-soft);
    font-size: 11.5px;
    line-height: 1.4;
    text-align: center;
    text-underline-offset: 3px;
  }

  @keyframes cb-in {
    from {
      opacity: 0;
      transform: scale(0.8) translateY(6px);
    }
  }

  @keyframes cb-typing {
    0%,
    60%,
    100% {
      transform: none;
      opacity: 0.5;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  @keyframes cb-pop {
    0% {
      transform: scale(0);
    }
    30% {
      transform: scale(1.18, 0.86);
    }
    46% {
      transform: scale(0.9, 1.1);
    }
    62% {
      transform: scale(1.05, 0.96);
    }
    78% {
      transform: scale(0.98, 1.02);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (max-width: 760px) {
    .cb-fab-wrap {
      right: 16px;
      bottom: calc(88px + env(safe-area-inset-bottom, 0px));
    }

    .cb-preview {
      max-width: calc(100vw - 120px);
    }

    .cb-box {
      top: calc(76px + env(safe-area-inset-top, 0px));
      right: 8px;
      bottom: calc(8px + env(safe-area-inset-bottom, 0px));
      left: 8px;
      width: auto;
      height: auto;
      max-height: 640px;
      margin-top: auto;
    }

    .cb-fab-wrap.is-open {
      opacity: 0;
      pointer-events: none;
    }

    .cb-fab-wrap.is-open .cb-fab {
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cb-fab-wrap.is-on .cb-fab,
    .cb-badge.is-pop,
    .cb-msg,
    .cb-chip,
    .cb-typing i {
      animation: none;
    }

    .cb-box,
    .cb-box.is-open,
    .cb-preview {
      transition: opacity 0.2s;
    }
  }
</style>
