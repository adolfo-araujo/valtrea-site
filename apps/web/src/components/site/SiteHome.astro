---
import { company, hasWhatsapp, talkUrl } from "../../config/company";
import { legalLabels, legalPath } from "../../config/legal";
import { sitePaths } from "../../config/paths";
import { dictionaryFor, type Locale } from "../../i18n";
import BrandIcon from "./BrandIcon.astro";
import Icon from "./Icon.astro";
import SiteShell from "./SiteShell.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = dictionaryFor(locale).site;
const p = sitePaths(locale);
const other = locale === "pt" ? "/en/" : "/";
const talk = { whatsapp: hasWhatsapp() ? company.whatsapp : "", email: company.email, subject: s.contact.subject };
const waHref = talkUrl(s.contact.message, s.contact.subject);
const waExternal = waHref.startsWith("https://");
const steps = s.process.steps;
const stepLabel = (index: number) => `${s.process.stepLabel} ${index + 1} ${s.process.of} ${steps.length}: ${steps[index]?.title ?? ""}`;
---

<SiteShell locale={locale} path={p.home} otherLanguageHref={other} intro>
  <div class="intro-stage" aria-hidden="true">
    <div class="intro-wall"></div>
    <p class="intro-line intro-one">{s.hero.titleStart}</p>
    <p class="intro-line intro-two">{s.hero.titleAccent}</p>
  </div>

  <section class="hero" id="topo" data-hero data-spot-zone>
    <div class="container hero-inner">
      <h1 class="hero-title" data-spot-block>
        <span>{s.hero.titleStart}</span>
        <em>{s.hero.titleAccent}</em>
      </h1>
      <div class="ask-card glass-plate" data-spot-block>
        <h2>{s.hero.askTitle}</h2>
        <p class="ask-sub">{s.hero.askSub}</p>
        <ol class="chat-log ask-log" data-ask-log hidden></ol>
        <form class="ask-form" data-ask>
          <label class="sr-only" for="ask-input">{s.hero.askLabel}</label>
          <input id="ask-input" type="text" autocomplete="off" maxlength="300" placeholder={s.hero.askPlaceholder} />
          <button type="submit" aria-label={s.hero.askSend}><Icon name="up" size={18} /></button>
        </form>
        <div class="ask-chips">
          {s.hero.chips.map((chip) => <button type="button" data-ask-chip>{chip}</button>)}
        </div>
      </div>
      <p class="ask-or" data-spot-block>
        {s.hero.or} <a href={p.contact}>{s.hero.startProject}</a> · <a href="#servicos">{s.hero.seeServices}</a>
      </p>
    </div>
  </section>

  <section class="stack" aria-label={s.stackLabel}>
    <ul class="container stack-list">
      {
        s.stack.map((tech) => (
          <li tabindex="0">
            <BrandIcon name={tech.icon} size={22} />
            <span>{tech.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section services plain-bg glass-scene" id="servicos">
    <canvas class="lava" data-lava aria-hidden="true"></canvas>
    <div class="container">
      <header class="section-head reveal">
        <h2 class="section-title">{s.services.title}</h2>
        <p class="section-sub">{s.services.sub}</p>
      </header>
      <div class="svc-card" data-tabs>
        <div class="svc-tabs-wrap">
          <div class="svc-tabs" role="tablist" aria-label={s.services.tabsLabel} data-tabs-track>
            <span class="svc-pill" data-tabs-pill aria-hidden="true"></span>
            {
              s.services.items.map((item, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${item.id}`}
                  aria-controls={`panel-${item.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                  data-id={item.id}
                >
                  {item.title}
                </button>
              ))
            }
          </div>
        </div>
        {
          s.services.items.map((item, index) => (
            <div class="svc-panel" role="tabpanel" id={`panel-${item.id}`} aria-labelledby={`tab-${item.id}`} hidden={index !== 0}>
              <div class="svc-copy">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <ul class="svc-tags">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
              <div class="svc-art" aria-hidden="true">
                <Icon name={item.icon} size={56} stroke={1.5} />
              </div>
            </div>
          ))
        }
        <div class="svc-idea">
          <p>
            <strong>{s.services.ideaStart}</strong>
            {s.services.ideaEnd}
          </p>
          <a class="svc-idea-btn liquid-glass" href={p.contact}>{s.services.ideaCta} <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section guarantees plain-bg" id="garantias">
    <div class="container guar-grid">
      <div>
        <header class="section-head reveal">
          <h2 class="section-title">{s.guarantees.title}</h2>
          <p class="section-sub">{s.guarantees.sub}</p>
        </header>
        <ul class="guar-list">
          {
            s.guarantees.items.map((item) => (
              <li class="reveal">
                <span class="guar-icon">
                  <Icon name={item.icon} size={22} />
                </span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mock-wrap" aria-hidden="true">
        <div class="mock-aura"></div>
        <div class="mock">
          <div class="mock-bar">
            <i class="d-red"></i><i class="d-yellow"></i><i class="d-green"></i>
            <span class="mock-url">{s.guarantees.url}</span>
          </div>
          <div class="mock-body">
            <div class="mock-top">
              <span class="sk sk-logo"></span>
              <span class="mock-menu"><span class="sk sk-dash"></span><span class="sk sk-dash"></span><span class="sk sk-dash"></span></span>
              <span class="sk-btn"></span>
            </div>
            <span class="sk sk-title" style="width: 86%"></span>
            <span class="sk sk-title" style="width: 60%"></span>
            <span class="sk sk-line" style="width: 92%"></span>
            <span class="sk sk-line" style="width: 70%"></span>
            <span class="sk sk-pill"></span>
            <div class="mock-cards"><span></span><span></span><span></span></div>
          </div>
          <span class="mock-sheen"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="showcase plain-bg" aria-labelledby="showcase-title">
    <canvas data-orb aria-hidden="true"></canvas>
    <div class="showcase-inner">
      <h2 id="showcase-title" class="showcase-title">{s.showcase.title}</h2>
      <div class="orb-stage">
        <span class="orb-ring" data-orb-ring aria-hidden="true"></span>
        <a class="showcase-pill liquid-glass" href={p.projects}>{s.showcase.cta} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section process" id="processo">
    <canvas data-stars aria-hidden="true"></canvas>
    <div class="container">
      <header class="section-head section-head--center reveal">
        <h2 class="section-title">{s.process.title}</h2>
      </header>
      <div class="prism-stage" data-cube tabindex="0" role="group" aria-roledescription={locale === "pt" ? "carrossel" : "carousel"} aria-label={s.process.title} aria-describedby="cube-hint">
        <ol class="prism">
          {
            steps.map((step, index) => (
              <li class="prism-face" data-face={index} data-label={stepLabel(index)} aria-label={stepLabel(index)}>
                <div class="prism-face-body">
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="prism-nav">
        <div class="prism-dots">
          {steps.map((_, index) => <button type="button" class="prism-dot" data-cube-dot aria-label={stepLabel(index)} aria-current={index === 0 ? "true" : "false"} />)}
        </div>
        <p class="prism-hint" id="cube-hint">{s.process.hint}</p>
      </div>
      <p class="sr-only" aria-live="polite" data-cube-live></p>
    </div>
  </section>

  <section class="cta" id="contato">
    <div class="cta-block">
      <div class="cta-blobs" aria-hidden="true"></div>
      <div class="container cta-inner">
        <h2>{s.contact.title}</h2>
        <p>{s.contact.sub}</p>
        <div class="cta-actions">
          <a class="cta-wa" href={waHref} target={waExternal ? "_blank" : undefined} rel={waExternal ? "noopener" : undefined}>
            {s.contact.whatsapp} <Icon name="arrow" size={18} />
          </a>
          <a class="cta-outline" href={p.contact}>{s.contact.email}</a>
        </div>
      </div>
    </div>
    <div class="cta-pixels" aria-hidden="true" data-spot-zone><canvas data-pixel-border></canvas></div>
  </section>

  <section class="section hire" id="empresas" data-spot-zone>
    <div class="container hire-grid">
      <div class="reveal" data-spot-block>
        <h2 class="section-title">{s.hire.title}</h2>
        <p class="section-sub">{s.hire.sub}</p>
      </div>
      <div class="hire-side" data-spot-block>
        <form class="hire-form" data-hire data-message={s.hire.message} data-whatsapp={talk.whatsapp} data-email={talk.email} data-subject={talk.subject} novalidate>
          <div class="hire-field">
            <svg class="hire-runner" aria-hidden="true"><rect x="0" y="0" width="100%" height="100%" rx="29" pathLength="100"></rect></svg>
            <label class="sr-only" for="hire-email">{s.hire.label}</label>
            <input id="hire-email" type="email" required autocomplete="email" placeholder={s.hire.placeholder} />
            <button type="submit">{s.hire.submit}</button>
          </div>
          <p class="hire-error" data-hire-error hidden>{s.hire.invalid}</p>
          <p class="hire-privacy">
            {locale === "pt" ? "Usamos seu e-mail só para responder ao seu contato." : "We only use your e-mail to reply to you."} <a href={legalPath(locale, "privacy")}>{legalLabels[locale].privacyPolicy}</a>
          </p>
        </form>
        <p class="hire-direct">
          {s.hire.or} <a href={waHref} target={waExternal ? "_blank" : undefined} rel={waExternal ? "noopener" : undefined}>{s.hire.direct}</a>
        </p>
      </div>
    </div>
  </section>
</SiteShell>

<style is:global>
  @property --spin {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes spin-angle {
    to {
      --spin: 360deg;
    }
  }

  .intro-stage {
    display: none;
  }

  html.intro {
    overflow: hidden;
  }

  html.intro .intro-stage {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--bg);
    transition: opacity 0.6s var(--ease);
  }

  html.intro .intro-line {
    grid-area: 1 / 1;
    margin: 0;
    padding: 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 9vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-align: center;
  }

  html.intro .intro-one {
    color: var(--text);
    animation:
      intro-rise 1s var(--ease) both,
      intro-sink 0.8s ease-in 1.35s forwards;
  }

  html.intro .intro-two {
    color: var(--brand);
    opacity: 0;
    animation: intro-emerge 1s var(--ease) 2.05s forwards;
  }

  html.intro .intro-wall {
    position: absolute;
    left: -10%;
    right: -10%;
    top: 50%;
    height: 46vh;
    background: radial-gradient(ellipse at center, #fff 0%, rgba(255, 255, 255, 0.95) 35%, rgba(255, 255, 255, 0) 70%);
    filter: blur(8px);
    transform: translateY(-50%) scaleY(0);
    animation: intro-wall 1.4s var(--ease) 1.1s forwards;
  }

  html.intro-done .intro-stage {
    opacity: 0;
    pointer-events: none;
  }

  html.intro .hero-title,
  html.intro .ask-card,
  html.intro .ask-or {
    opacity: 0;
    transform: translateY(28px);
  }

  html.intro-done .hero-title,
  html.intro-done .ask-card,
  html.intro-done .ask-or {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease),
      transform 0.8s var(--ease);
  }

  html.intro-done .ask-card,
  html.intro-done .ask-or {
    transition-delay: 0.3s;
  }

  @keyframes intro-rise {
    from {
      opacity: 0;
      transform: translateY(60px);
    }
  }

  @keyframes intro-sink {
    to {
      opacity: 0;
      transform: translateY(26px) scale(0.96);
      filter: blur(6px);
    }
  }

  @keyframes intro-wall {
    40% {
      transform: translateY(-50%) scaleY(1);
      opacity: 1;
    }
    to {
      transform: translateY(-50%) scaleY(1.4);
      opacity: 0;
    }
  }

  @keyframes intro-emerge {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>

<style>
  .hero {
    padding: clamp(7.5rem, 14vw, 10rem) 0 3rem;
  }

  .hero-inner {
    display: grid;
    justify-items: center;
    gap: 2.5rem;
    text-align: center;
  }

  .hero-title {
    font-size: clamp(2.7rem, 8vw, 6rem);
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .hero-title span,
  .hero-title em {
    display: block;
  }

  .hero-title em {
    font-style: normal;
    color: var(--brand);
  }

  .ask-card {
    width: min(100%, 40rem);
    padding: clamp(1.4rem, 3vw, 2rem);
    text-align: left;
  }

  .ask-card h2 {
    font-size: 1.6rem;
  }

  .ask-sub {
    margin: 0.5rem 0 1.1rem;
    color: var(--text-soft);
    font-size: 0.97rem;
  }

  .ask-log {
    max-height: 18rem;
    margin-bottom: 0.9rem;
    overflow-y: auto;
  }

  .ask-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.35rem 0.35rem 0.35rem 1.1rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
  }

  .ask-form input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    outline: none;
  }

  .ask-form button {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: var(--text);
    color: #fff;
    cursor: pointer;
  }

  .ask-form button:hover {
    background: var(--brand);
  }

  .ask-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  .ask-chips button {
    padding: 0.55rem 1.05rem;
    border: 1px solid rgba(17, 17, 22, 0.16);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(17, 17, 22, 0.06), 0 6px 14px -10px rgba(17, 17, 22, 0.3);
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .ask-chips button:hover {
    border-color: var(--brand);
    color: var(--text);
  }

  .ask-or {
    margin: -1rem 0 0;
    color: var(--text-mute);
    font-size: 0.95rem;
    text-align: center;
  }

  .ask-or a {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(17, 17, 22, 0.3);
  }

  .stack {
    padding: 1.5rem 0 1rem;
  }

  .stack-list {
    display: flex;
    flex-wrap: nowrap;
    justify-content: safe center;
    gap: clamp(0.7rem, 1.5vw, 1.5rem);
    max-width: none;
    margin: 0 auto;
    padding: 0 var(--gutter);
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .stack-list::-webkit-scrollbar {
    display: none;
  }

  .stack-list li {
    display: inline-flex;
    align-items: center;
    flex: none;
    gap: 0.45rem;
    padding: 0.35rem 0.2rem;
    color: #9a9ba3;
    font-size: clamp(0.85rem, 1.05vw, 0.95rem);
    font-weight: 500;
    white-space: nowrap;
    outline: none;
    cursor: default;
    transition: color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .stack-list li:hover,
  .stack-list li:focus-visible,
  .stack-list li:active {
    color: var(--text);
    transform: translateY(-2px);
  }

  .services {
    overflow: clip;
  }

  .glass-scene {
    isolation: isolate;
  }

  .glass-scene::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(30% 36% at 10% 20%, rgba(255, 255, 255, 0.9), transparent 70%),
      radial-gradient(34% 42% at 28% 82%, rgba(30, 34, 45, 0.11), transparent 70%),
      radial-gradient(26% 32% at 55% 10%, rgba(255, 255, 255, 0.75), transparent 70%),
      radial-gradient(34% 42% at 88% 30%, rgba(30, 34, 45, 0.12), transparent 70%),
      radial-gradient(32% 38% at 70% 92%, rgba(255, 255, 255, 0.85), transparent 70%);
  }

  .lava {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    contain: strict;
    mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
  }

  .services .container {
    position: relative;
    z-index: 1;
  }

  .services .section-head {
    max-width: 680px;
    margin-bottom: 48px;
    text-align: left;
  }

  .svc-card {
    position: relative;
    isolation: isolate;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 24px;
    background: linear-gradient(140deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.95) 55%, rgba(255, 255, 255, 0.97));
    box-shadow:
      inset 0 1px 0 #fff,
      inset 0 -14px 28px -22px rgba(17, 17, 22, 0.1),
      0 0 0 1px rgba(17, 17, 22, 0.05),
      0 22px 44px -28px rgba(17, 17, 22, 0.28);
  }

  .svc-card::after {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 45%;
    border-radius: inherit;
    background: linear-gradient(rgba(255, 255, 255, 0.55), transparent);
    pointer-events: none;
  }

  .svc-tabs-wrap {
    position: relative;
  }

  .svc-tabs {
    position: relative;
    display: flex;
    gap: 4px;
    padding: 5px;
    border-radius: 999px;
    background: rgba(17, 17, 22, 0.04);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .svc-tabs::-webkit-scrollbar {
    display: none;
  }

  .svc-tabs button {
    position: relative;
    z-index: 1;
    flex: 1 0 auto;
    padding: 11px 16px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--text-soft);
    font: inherit;
    font-size: 14.5px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.25s;
  }

  .svc-tabs button:hover,
  .svc-tabs button.is-active {
    color: var(--text);
  }

  .svc-pill {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    background: radial-gradient(ellipse 70% 100% at 50% 50%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.6) 60%, rgba(255, 255, 255, 0.3) 100%);
    box-shadow:
      -1px 0 0 rgba(17, 17, 22, 0.32),
      1px 0 0 rgba(17, 17, 22, 0.32),
      0 0 0 0.5px rgba(17, 17, 22, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(4px) saturate(1.3);
    opacity: 0;
  }

  .svc-pill.is-ready {
    opacity: 1;
    transition:
      transform 0.55s cubic-bezier(0.3, 1.25, 0.45, 1),
      width 0.55s cubic-bezier(0.3, 1.25, 0.45, 1);
  }

  .svc-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 40px;
    min-height: 250px;
    padding: 40px 36px 34px;
  }

  .svc-panel:not([hidden]) {
    animation: svc-in 0.5s var(--ease) both;
  }

  .svc-panel:not([hidden]) .svc-art {
    animation: art-in 0.7s var(--ease) both;
  }

  @keyframes svc-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes art-in {
    from {
      opacity: 0;
      transform: rotate(-12deg) scale(0.85);
    }
  }

  .svc-copy h3 {
    margin: 0 0 10px;
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.03em;
  }

  .svc-copy p {
    max-width: 52ch;
    margin: 0 0 22px;
    color: var(--text-soft);
    font-size: 16.5px;
  }

  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-tags li {
    padding: 5px 12px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    background: linear-gradient(140deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.78) 55%, rgba(255, 255, 255, 0.86) 100%);
    box-shadow:
      inset 0 1px 0 #fff,
      0 0 0 1px rgba(17, 17, 22, 0.07),
      0 6px 14px -10px rgba(17, 17, 22, 0.25);
    color: var(--text-soft);
    font-size: 12.5px;
    font-weight: 500;
  }

  .svc-art {
    display: inline-flex;
    align-items: center;
    justify-content: center;
