---
interface Props {
  country: "br" | "us";
  size?: number;
}

const { country, size = 22 } = Astro.props;
---

{
  country === "br" ? (
    <svg class="flag" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
      <g>
        <rect width="32" height="32" fill="#009b3a" />
        <path d="M16 5.5 29 16 16 26.5 3 16Z" fill="#fedf00" />
        <circle cx="16" cy="16" r="6.2" fill="#002776" />
        <path d="M10 14.6c3.9-.7 8.4.3 11.9 2.6l-.3.9c-3.4-2.2-7.7-3.1-11.4-2.5Z" fill="#fff" />
      </g>
    </svg>
  ) : (
    <svg class="flag" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
      <g>
        <rect width="32" height="32" fill="#fff" />
        <path d="M0 0h32v2.5H0Zm0 5h32v2.5H0Zm0 5h32v2.5H0Zm0 5h32v2.5H0Zm0 5h32v2.5H0Zm0 5h32v2.5H0Zm0 5h32V32H0Z" fill="#b22234" />
        <rect width="16" height="17.5" fill="#3c3b6e" />
        <g fill="#fff">
          <circle cx="3" cy="3" r=".9" /><circle cx="8" cy="3" r=".9" /><circle cx="13" cy="3" r=".9" />
          <circle cx="5.5" cy="6.5" r=".9" /><circle cx="10.5" cy="6.5" r=".9" />
          <circle cx="3" cy="10" r=".9" /><circle cx="8" cy="10" r=".9" /><circle cx="13" cy="10" r=".9" />
          <circle cx="5.5" cy="13.5" r=".9" /><circle cx="10.5" cy="13.5" r=".9" />
        </g>
      </g>
    </svg>
  )
}

<style>
  .flag {
    display: block;
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(17, 17, 22, 0.12);
  }
</style>
