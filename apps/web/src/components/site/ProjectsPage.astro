---
import { sitePaths } from "../../config/paths";
import { androidApps, demos, liveProducts, type ShowcaseItem } from "../../config/showcase";
import { dictionaryFor, type Locale } from "../../i18n";
import BrandIcon from "./BrandIcon.astro";
import Icon from "./Icon.astro";
import SiteShell from "./SiteShell.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = dictionaryFor(locale).site;
const t = s.projectsPage;
const p = sitePaths(locale);
const other = sitePaths(locale === "pt" ? "en" : "pt").projects;
const groups: { id: string; title: string; sub: string; items: ShowcaseItem[]; external: boolean }[] = [
  { id: "no-ar", title: t.liveTitle, sub: t.liveSub, items: liveProducts, external: true },
  { id: "demos", title: t.demoTitle, sub: t.demoSub, items: demos, external: false },
];
---

<SiteShell locale={locale} path={p.projects} otherLanguageHref={other} title={`${t.title.replace(".", "")} | Valtrea`} description={t.sub} compactFooter>
  <section class="proj-hero" data-spot-zone>
    <div class="container proj-hero-grid">
      <div data-spot-block>
        <h1>{t.title}</h1>
        <p>{t.sub}</p>
      </div>
      <div class="proj-sky" aria-hidden="true" data-spot-block><canvas class="proj-orb" data-orb="still" data-orb-ring></canvas></div>
    </div>
  </section>

  {
    groups.map((group) => (
      <section class="proj-group plain-bg" id={group.id}>
        <div class="container">
          <header class="proj-head">
            <h2>{group.title}</h2>
            <p>{group.sub}</p>
          </header>
          <ul class="proj-rows">
            {group.items.map((item) => (
              <li>
                <a
                  class="proj-row liquid-glass"
                  href={item.href}
                  target={group.external ? "_blank" : undefined}
                  rel={group.external ? "noopener" : undefined}
                  style={`--hue: ${item.hue}`}
                >
                  <span class="proj-icon">
                    <Icon name={item.icon} size={22} stroke={1.6} />
                  </span>
                  <span class="proj-text">
                    <strong>{item.name}</strong>
                    <span>{locale === "pt" ? item.pt : item.en}</span>
                    <small>
                      <i />
                      {item.domain}
                    </small>
                  </span>
                  <span class="proj-tag">
                    <i style={`--dot: hsl(${item.hue}, 70%, 50%)`} />
                    {group.external ? (locale === "pt" ? "No ar" : "Live") : locale === "pt" ? "Demonstração" : "Demo"}
                  </span>
                  <span class="proj-arrow">
                    <Icon name="arrow" size={20} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="proj-group plain-bg" id="celular">
    <div class="container">
      <header class="proj-head">
        <h2>{t.appsTitle}</h2>
        <p>{t.appsSub}</p>
      </header>
      <ul class="proj-apps">
        {
          androidApps.map((app) => (
            <li class="glass-plate">
              <span class="app-icon">
                <img src="/brand/mark.png" alt="" width="28" height="28" />
              </span>
              <strong>Valtrea {app.name}</strong>
              <span class="app-lang">
                <i />
                Kotlin
              </span>
              <span class="app-soon">
                <BrandIcon name="kotlin" size={12} /> {t.soon}
              </span>
            </li>
          ))
        }
      </ul>
      <a class="proj-next" href={p.contact}>
        <span class="proj-plus">+</span>
        <span>
          <strong>{t.nextTitle}</strong>
          <span>{t.nextSub}</span>
        </span>
        <Icon name="arrow" size={20} />
      </a>
    </div>
  </section>
</SiteShell>

<script>
  if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
    document.addEventListener(
      "pointermove",
      (event) => {
        const row = (event.target as Element | null)?.closest?.<HTMLElement>(".proj-row");
        if (!row) return;
        const box = row.getBoundingClientRect();
        row.style.setProperty("--mx", `${event.clientX - box.left}px`);
        row.style.setProperty("--my", `${event.clientY - box.top}px`);
        row.style.setProperty("--glow", "1");
      },
      { passive: true },
    );
    document.addEventListener(
      "pointerout",
      (event) => {
        const row = (event.target as Element | null)?.closest?.<HTMLElement>(".proj-row");
        if (row && !row.contains(event.relatedTarget as Node | null)) row.style.setProperty("--glow", "0");
      },
      { passive: true },
    );
  }
</script>

<style>
  .proj-hero {
    position: relative;
    padding: clamp(7rem, 12vw, 8.5rem) 0 2rem;
  }

  .proj-orb {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .proj-hero-grid {
    position: relative;
  }

  .proj-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 2rem;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 5rem);
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .proj-hero p {
    max-width: 32rem;
    margin: 1rem 0 0;
    color: var(--text-soft);
    font-size: 1.08rem;
  }

  .proj-sky {
    position: relative;
    justify-self: end;
    width: clamp(280px, 34vw, 440px);
    aspect-ratio: 1;
    margin: -40px 0;
  }

  .proj-group {
    padding: 2.5rem 0;
  }

  .proj-head {
    margin-bottom: 1.25rem;
  }

  .proj-head h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }

  .proj-head p {
    margin: 0.4rem 0 0;
    color: var(--text-soft);
  }

  .proj-rows,
  .proj-apps {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .proj-row {
    --mx: 50%;
    --my: 0%;
    --glow: 0;
    --sheen: 160%;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 1.6rem;
    border-radius: 24px;
    background: #fff;
    border: 1px solid rgba(17, 17, 22, 0.1);
    box-shadow: 0 1px 2px rgba(17, 17, 22, 0.04);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.45s var(--ease),
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .proj-row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background:
      linear-gradient(105deg, transparent 38%, rgba(17, 17, 22, 0.05) 48%, rgba(17, 17, 22, 0.02) 52%, transparent 62%) var(--sheen) 0 / 260% 100% no-repeat,
      radial-gradient(420px circle at var(--mx) var(--my), rgba(17, 17, 22, calc(0.045 * var(--glow))), transparent 60%);
    animation: proj-sheen 9s linear infinite;
    pointer-events: none;
  }

  .proj-row::after {
    content: "";
    position: absolute;
    inset: -1px;
    padding: 1px;
    border-radius: inherit;
    background: radial-gradient(260px circle at var(--mx) var(--my), rgba(17, 17, 22, 0.45), transparent 70%);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    opacity: var(--glow);
    transition: opacity 0.35s;
    pointer-events: none;
  }

  .proj-row:hover::before {
    animation: proj-sheen-hover 1.1s cubic-bezier(0.45, 0, 0.25, 1);
  }

  @keyframes proj-sheen {
    0%,
    70% {
      background-position: 160% 0, 0 0;
    }
    100% {
      background-position: -60% 0, 0 0;
    }
  }

  @keyframes proj-sheen-hover {
    from {
      background-position: 160% 0, 0 0;
    }
    to {
      background-position: -60% 0, 0 0;
    }
  }

  .proj-row:hover,
  .proj-row:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(17, 17, 22, 0.3);
    box-shadow: 0 26px 50px -26px rgba(17, 17, 22, 0.3);
  }

  .proj-row:active {
    transform: translateY(0) scale(0.99);
    transition-duration: 0.15s;
  }

  .proj-row:hover .proj-arrow {
    transform: translateX(4px);
  }

  .proj-row .proj-arrow {
    transition: transform 0.45s var(--ease);
  }

  @media (hover: none) {
    .proj-row:hover {
      transform: none;
    }

    .proj-row::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-row,
    .proj-row::before,
    .proj-row::after,
    .proj-row .proj-arrow {
      transition: none;
      animation: none;
    }
  }

  .proj-text strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .proj-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .proj-tag i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--dot);
  }

  .proj-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: #fff;
    border: 1px solid rgba(17, 17, 22, 0.14);
    color: var(--text);
  }

  .proj-text {
    display: grid;
    flex: 1;
    min-width: 0;
    gap: 0.1rem;
  }

  .proj-text > span {
    color: var(--text-soft);
    font-size: 0.93rem;
  }

  .proj-text small {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.25rem;
    color: var(--text-mute);
    font-size: 0.8rem;
  }

  .proj-text small i,
  .app-lang i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--live);
  }

  .proj-arrow {
    display: grid;
    place-items: center;
    flex: none;
    margin-left: 0.6rem;
  }

  .proj-apps {
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
  }

  .proj-apps li {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem;
  }

  .app-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.4rem;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
  }

  .app-lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-soft);
    font-size: 0.85rem;
  }

  .app-lang i {
    background: #7f52ff;
  }

  .app-soon {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-mute);
    font-size: 0.78rem;
  }

  .proj-next {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: 2rem;
    padding: 1.4rem 1.5rem;
    border: 1.5px dashed var(--line-strong);
    border-radius: 22px;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .proj-next:hover {
    border-color: var(--brand);
    background: rgba(255, 255, 255, 0.6);
  }

  .proj-next > span:nth-child(2) {
    display: grid;
    flex: 1;
  }

  .proj-next > span:nth-child(2) span {
    color: var(--text-soft);
    font-size: 0.93rem;
  }

  .proj-plus {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border: 1.5px dashed var(--line-strong);
    border-radius: 50%;
    color: var(--text-mute);
    font-size: 1.5rem;
  }

  @media (max-width: 760px) {
    .proj-hero-grid {
      grid-template-columns: 1fr;
    }

    .proj-sky {
      justify-self: center;
      width: min(18rem, 80vw);
    }

    h1 {
      white-space: normal;
    }

    .proj-tag {
      display: none;
    }

    .proj-row {
      padding: 0.9rem;
      gap: 0.8rem;
    }

    .proj-icon {
      width: 2.7rem;
      height: 2.7rem;
    }
  }
</style>
