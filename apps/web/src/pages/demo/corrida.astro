---
import { existsSync } from "node:fs";
import { join } from "node:path";
import DemoFrame from "../../components/demo/DemoFrame.astro";
import RunArt from "../../components/demo/RunArt.astro";

const money = (value: number) => new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(value);
const photo = (name: string) => (existsSync(join(process.cwd(), "public", "demo", "corrida", name)) ? `/demo/corrida/${name}` : "");

const products = [
  { id: "oculos", eye: "(Óculos)", name: "Óculos polarizado UV400", text: "Corta o reflexo do asfalto, armação leve e ponteira de borracha que não escorrega com o suor.", chips: ["Polarizado", "UV400", "Não balança"], price: 59.9, sizes: false, show: "" },
  { id: "shorts-f", eye: "(Feminino)", name: "Shorts 2 em 1 feminino", text: "Laterais em tela para ventilar, cós com cordão que não enrola e bolso para o celular.", chips: ["Não fica transparente", "Bolso", "3 cores"], price: 79.9, sizes: true, show: "" },
  { id: "shorts-m", eye: "(Masculino)", name: "Shorts 2 em 1 masculino", text: "Shorts por fora e compressão por dentro: acaba com o atrito entre as coxas.", chips: ["Antiassadura", "Bolso lateral", "Seca rápido"], price: 79.9, sizes: true, show: "" },
  { id: "cinto", eye: "(Acessórios)", name: "Cinto porta-celular", text: "Faixa elástica que veste por baixo da roupa e segura o celular sem pular.", chips: ["Celular parado", "Chave e cartão", "Lavável"], price: 39.9, sizes: false, show: "" },
];
const pix = (value: number) => money(Math.round(value * 95) / 100);
const store = {
  products: products.map(({ id, name, price, sizes }) => ({ id, name, price, ...(sizes ? { options: ["tamanho"] } : {}) })),
  groups: [{ id: "tamanho", label: "Tamanho", type: "single" as const, required: true, choices: ["PP", "P", "M", "G", "GG"].map((label) => ({ label })) }],
  modes: ["envio"] as "envio"[],
  shipping: 19.9,
  freeFrom: 199,
  payments: ["Pix (5% off)", "Cartão em até 6x sem juros"],
};
const faq = [
  ["Como funciona o pedido?", "Você coloca os produtos na sacola e toca em finalizar. Aparece o pedido pronto, com tamanhos, para mandar no WhatsApp; a loja confirma o endereço e o frete, você paga no Pix ou no cartão e recebe com rastreio."],
  ["O óculos balança ou escorrega quando eu corro?", "Não. A armação é leve e a ponteira tem borracha para segurar mesmo com suor."],
  ["O shorts fica transparente?", "Não. O tecido é grosso e passa no teste do agachamento."],
  ["E se o tamanho não servir?", "A primeira troca de tamanho é grátis. Fale com a loja em até 7 dias depois de receber."],
  ["Serve para outros esportes?", "Sim. O óculos e o shorts funcionam para bike, beach tennis e academia."],
  ["Quanto tempo demora para chegar?", "Enviamos em até 24h úteis. O prazo de entrega depende do seu CEP e aparece antes de você pagar."],
];
const sizes = {
  feminino: { caption: "Shorts feminino", rows: [["PP", "58–62", "84–88"], ["P", "62–66", "88–92"], ["M", "66–72", "92–98"], ["G", "72–78", "98–104"], ["GG", "78–84", "104–110"]] },
  masculino: { caption: "Shorts masculino", rows: [["P", "70–76", "90–96"], ["M", "76–82", "96–102"], ["G", "82–88", "102–108"], ["GG", "88–96", "108–116"], ["XG", "96–104", "116–124"]] },
};
const gallery = [
  { shape: "ret", file: "equipe-1.jpg", sky: ["#3a86e0", "#a9cbef"], runners: 3 },
  { shape: "capsule", file: "equipe-2.jpg", sky: ["#eb4b26", "#ffc59e"], runners: 2 },
  { shape: "ret", file: "equipe-3.jpg", sky: ["#1f5fb0", "#6faeeb"], runners: 2 },
  { shape: "oval", file: "equipe-4.jpg", sky: ["#f2b544", "#fde7b0"], runners: 4 },
].map((item) => ({ ...item, src: photo(item.file) }));
const heroPhoto = photo("hero.jpg");
const runner = "M14 4a4 4 0 1 1 0 8a4 4 0 0 1 0-8ZM12 14l-6 6l3 3l5-4l2 8l-7 9l3 3l8-9l4 5l-3 9l4 1l4-11l-6-8l-1-7l6 3l5-4l-2-3l-4 3l-8-4Z";
---

<DemoFrame
  brand="Passada"
  title="Passada · loja de corrida para quem está começando (demonstração)"
  description="Loja de corrida de demonstração feita pela Valtrea: feminino e masculino, guia de tamanhos e pedido pelo WhatsApp."
  path="/demo/corrida"
  themeColor="#3A86E0"
  bodyClass="corrida"
  store={store}
>
  <header class="r-top" data-r-top>
    <a class="r-logo" href="#topo">Passada</a>
    <nav class="r-menu" aria-label="Loja">
      <button type="button" data-tab="feminino" aria-pressed="true">(Feminino)</button>
      <button type="button" data-tab="masculino" aria-pressed="false">(Masculino)</button>
      <a href="#oculos">(Óculos)</a>
      <a href="#shorts-f">(Shorts)</a>
      <a href="#cinto">(Cinto)</a>
    </nav>
    <button class="r-bag" type="button" data-bag-open>Sacola <b data-bag-count hidden>0</b></button>
  </header>

  <section class="r-hero" id="topo">
    <div class="r-hero-text">
      <div class="r-version" role="group" aria-label="Versão da loja">
        <button type="button" data-tab="feminino" aria-pressed="true">Feminino</button>
        <button type="button" data-tab="masculino" aria-pressed="false">Masculino</button>
      </div>
      <h1 class="r-hero-title">
        <span data-show="feminino">Seu primeiro 5&nbsp;km,<br />com cara de atleta</span>
        <span data-show="masculino" hidden>Corra mais,<br />sem assadura</span>
      </h1>
      <p class="r-hero-sub">
        <span data-show="feminino">Óculos polarizado que não balança, shorts que não fica transparente e bolso firme para o celular. Tudo o que falta além do tênis.</span>
        <span data-show="masculino" hidden>Óculos polarizado que não escorrega com o suor e shorts de compressão que acaba com a assadura. Tudo o que falta além do tênis.</span>
      </p>
      <a class="r-btn" href="#oculos">Ver os produtos</a>
      <p class="r-count" data-r-count>Faltam <strong>–</strong> dias para a São Silvestre</p>
    </div>

    <div class="r-stage">
      <svg class="r-mark" viewBox="0 0 1320 430" role="img" aria-label="Run more, com corredores dentro das letras">
        <defs>
          <clipPath id="r-letters">
            <text x="660" y="380" text-anchor="middle" textLength="1260" lengthAdjust="spacingAndGlyphs">RUN MORE</text>
          </clipPath>
          <linearGradient id="r-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffd59a" />
            <stop offset="0.45" stop-color="#ff8a5c" />
            <stop offset="1" stop-color="#eb4b26" />
          </linearGradient>
          <linearGradient id="r-track" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#c7472a" />
            <stop offset="1" stop-color="#7c2412" />
          </linearGradient>
          <symbol id="r-runner" viewBox="0 0 40 50"><path d={runner} /></symbol>
        </defs>
        <g clip-path="url(#r-letters)">
          {
            heroPhoto ? (
              <image href={heroPhoto} x="0" y="0" width="1320" height="430" preserveAspectRatio="xMidYMid slice" />
            ) : (
              <g>
                <rect width="1320" height="430" fill="url(#r-sky)" />
                <circle cx="980" cy="150" r="90" fill="#fff3d6" opacity="0.85" />
                <path d="M0 250 Q330 210 660 245 T1320 235 V430 H0Z" fill="#f4a261" opacity="0.6" />
                <rect y="285" width="1320" height="145" fill="url(#r-track)" />
                {[300, 330, 362, 398].map((y) => <rect y={y} width="1320" height="3" fill="#fff" opacity="0.55" />)}
                {[120, 300, 470, 650, 820, 1000, 1180].map((x, index) => (
                  <use href="#r-runner" x={x} y={150 + (index % 3) * 12} width="110" height="138" fill="#1b1d22" />
                ))}
              </g>
            )
          }
        </g>
        <text class="r-mark-edge" x="660" y="380" text-anchor="middle" textLength="1260" lengthAdjust="spacingAndGlyphs">RUN MORE</text>
      </svg>
    </div>
  </section>

  <ul class="r-perks" aria-label="Benefícios da loja">
    <li><strong>Troca grátis de tamanho</strong><span>em até 7 dias</span></li>
    <li><strong>Envio em até 24h úteis</strong><span>com rastreio</span></li>
    <li><strong>até 6x sem juros</strong><span>no cartão</span></li>
    <li><strong>5% off no Pix</strong><span>em qualquer pedido</span></li>
  </ul>

  <section class="r-section">
    <div class="r-wrap">
      <header class="r-head revela"><p class="r-eye">(A loja)</p><h2 class="r-title">Tudo para o seu 5 km</h2></header>
      <div class="r-stack">
        {
          products.map((product, index) => (
            <article class:list={["r-pd", "revela", { "r-pd--flip": index % 2 === 1 }]} id={product.id}>
              <button class="r-pd-photo" type="button" data-add={product.id} aria-label={`Escolher ${product.name}`}>
                {photo(`${product.id}.jpg`) ? (
                  <img class="r-art" src={photo(`${product.id}.jpg`)} alt={product.name} loading="lazy" />
                ) : (
                  <svg class="r-art" viewBox="0 0 400 400" aria-hidden="true">
                    <use href={`#art-${product.id}`} />
                  </svg>
                )}
                {photo(`${product.id}-uso.jpg`) ? (
                  <img class="r-art r-art--use" src={photo(`${product.id}-uso.jpg`)} alt="" loading="lazy" />
                ) : (
                  <svg class="r-art r-art--use" viewBox="0 0 400 400" aria-hidden="true">
                    <use href={`#use-${product.id}`} />
                  </svg>
                )}
                <span class="r-pd-num">0{index + 1}</span>
              </button>
              <div class="r-pd-text">
                <p class="r-eye">{product.eye}</p>
                <h3 class="r-pd-name">{product.name}</h3>
                <p class="r-pd-desc">{product.text}</p>
                <ul class="r-chips">{product.chips.map((chip) => <li>{chip}</li>)}</ul>
                <div class="r-pd-buy">
                  <p class="r-price"><strong>{money(product.price)}</strong><small>{pix(product.price)} no Pix</small></p>
                  <div class="r-pd-actions">
                    <button class="r-btn r-btn--sm" type="button" data-add={product.id}>{product.sizes ? "Escolher tamanho" : "Adicionar"}</button>
                    <a class="r-btn-line" href="#duvidas">Dúvidas</a>
                  </div>
                </div>
                {product.sizes && <a class="r-pd-link" href="#medidas">Guia de medidas</a>}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="r-section r-section--cream" id="medidas">
    <div class="r-wrap r-two">
      <div class="revela">
        <p class="r-eye">(Guia de tamanhos)</p>
        <h2 class="r-title">Qual é o<br />meu tamanho?</h2>
        <p class="r-text">Ficou entre dois? Pega o maior. Se não servir, a primeira troca de tamanho é por conta da loja.</p>
      </div>
      <div class="revela">
        {
          Object.entries(sizes).map(([key, table]) => (
            <div class="r-sizes" data-show={key} hidden={key !== "feminino"}>
              <table>
                <caption>{table.caption}</caption>
                <thead>
                  <tr><th scope="col">Tamanho</th><th scope="col">Cintura</th><th scope="col">Quadril</th></tr>
                </thead>
                <tbody>
                  {table.rows.map((row) => (
                    <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))
        }
        <p class="r-note">Medidas do shorts em centímetros, com o corpo.</p>
      </div>
    </div>
  </section>

  <section class="r-section">
    <div class="r-wrap">
      <header class="r-head revela"><p class="r-eye">(#meuprimeiro5k)</p><h2 class="r-title">Na linha de chegada</h2></header>
      <ul class="r-finish">
        {
          gallery.map((item) => (
            <li class:list={["revela", "r-shape", `r-shape--${item.shape}`]}>
              {item.src ? (
                <img src={item.src} alt="Corredores na linha de chegada" loading="lazy" />
              ) : (
                <svg viewBox="0 0 300 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                  <defs>
                    <linearGradient id={`g-${item.file}`} x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color={item.sky[1]} />
                      <stop offset="1" stop-color={item.sky[0]} />
                    </linearGradient>
                  </defs>
                  <rect width="300" height="400" fill={`url(#g-${item.file})`} />
                  <circle cx="220" cy="90" r="46" fill="#fff" opacity="0.55" />
                  <rect y="300" width="300" height="100" fill="#1b1d22" opacity="0.18" />
                  {Array.from({ length: item.runners }, (_, index) => (
                    <use href="#r-runner" x={30 + index * (220 / item.runners)} y={170 + (index % 2) * 14} width="90" height="130" fill="#14161a" />
                  ))}
                  <rect x="0" y="292" width="300" height="10" fill="#fff" opacity="0.9" />
                </svg>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="r-section r-section--flush" id="duvidas">
    <div class="r-wrap r-two r-two--top">
      <div class="revela">
        <p class="r-eye">(Antes de comprar)</p>
        <h2 class="r-title">Dúvidas</h2>
        <p class="r-text">Não achou a sua? Pergunte no WhatsApp quando finalizar o pedido.</p>
      </div>
      <div class="r-faq">
        {
          faq.map(([question, answer]) => (
            <details class="revela">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <footer class="r-foot">
    <div class="r-wrap">
      <p class="r-foot-mark">Passada</p>
      <div class="r-foot-grid">
        <p>Para quem está começando a correr e quer chegar inteiro, e bonito, na primeira prova.</p>
        <div><p>Seg. a sáb., 8h às 20h</p><p>Pedidos pelo WhatsApp</p></div>
        <div><p><a href="#oculos">Produtos</a></p><p><a href="#medidas">Guia de tamanhos</a></p><p><a href="#duvidas">Trocas e dúvidas</a></p></div>
      </div>
      <p class="r-legal">© {new Date().getFullYear()} Passada · marca fictícia</p>
    </div>
  </footer>

  <RunArt />
</DemoFrame>

<script>
  const top = document.querySelector<HTMLElement>("[data-r-top]");
  const ribbon = document.querySelector<HTMLElement>(".demo-ribbon");
  const markTop = () => {
    top?.style.setProperty("--ribbon", `${Math.max(0, (ribbon?.offsetHeight ?? 0) - window.scrollY)}px`);
    top?.classList.toggle("is-scrolled", window.scrollY > 40);
  };
  window.addEventListener("scroll", markTop, { passive: true });
  markTop();

  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
  const show = (value: string, remember: boolean) => {
    tabs.forEach((tab) => tab.setAttribute("aria-pressed", String(tab.dataset.tab === value)));
    document.querySelectorAll<HTMLElement>("[data-show]").forEach((element) => {
      element.hidden = element.dataset.show !== value;
    });
    if (remember) {
      const url = new URL(window.location.href);
      url.searchParams.set("kit", value);
      history.replaceState(null, "", url);
    }
  };
  tabs.forEach((tab) => tab.addEventListener("click", () => show(tab.dataset.tab ?? "feminino", true)));
  const kit = new URLSearchParams(window.location.search).get("kit");
  show(kit === "masculino" ? "masculino" : "feminino", false);

  const counter = document.querySelector<HTMLElement>("[data-r-count] strong");
  if (counter) {
    const now = new Date();
    let race = new Date(now.getFullYear(), 11, 31);
    if (race < now) race = new Date(now.getFullYear() + 1, 11, 31);
    counter.textContent = String(Math.ceil((race.getTime() - now.getTime()) / 86400000));
  }

  const revealed = document.querySelectorAll<HTMLElement>(".revela");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-on");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
    );
    revealed.forEach((element) => observer.observe(element));
  } else {
    revealed.forEach((element) => element.classList.add("is-on"));
  }
</script>

<style is:global>
  body.corrida {
    --d-bg: #faf7f1;
    --d-surface: #ffffff;
    --d-ink: #121417;
    --d-mute: #66645f;
    --d-line: #e4ddd0;
    --d-accent: #eb4b26;
    --d-accent-ink: #ffffff;
    background: #faf7f1;
    color: #121417;
    font-family: "Inter", var(--font-sans);
  }
</style>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap");


  .r-wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .r-top {
    position: fixed;
    inset: var(--ribbon, 2rem) 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem clamp(1.25rem, 3vw, 2.5rem);
    color: #fff;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease),
      padding 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .r-top.is-scrolled {
    top: 0;
    padding-block: 0.8rem;
    background: rgba(250, 247, 241, 0.94);
    box-shadow: 0 1px 0 #e4ddd0;
    color: #121417;
    backdrop-filter: blur(12px);
  }

  .r-logo {
    font-family: "Anton", Impact, sans-serif;
    font-size: 1.9rem;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    color: inherit;
  }

  .r-menu {
    display: flex;
    gap: 1.1rem;
  }

  .r-menu a,
  .r-menu button {
    padding: 0.3rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    text-transform: uppercase;
    opacity: 0.85;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .r-menu a:hover,
  .r-menu button:hover {
    opacity: 1;
  }

  .r-menu button[aria-pressed="true"] {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 5px;
    opacity: 1;
  }

  .r-bag {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.3rem;
    border: 0;
    border-radius: 6px;
    background: #fff;
    color: #121417;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .r-bag:hover,
  .r-top.is-scrolled .r-bag {
    background: #121417;
    color: #fff;
  }

  .r-bag b {
    display: grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: #eb4b26;
    color: #fff;
    font-size: 0.72rem;
  }

  .r-hero {
    position: relative;
    overflow: clip;
    padding: clamp(9rem, 15vw, 11.5rem) clamp(1rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
    background: linear-gradient(180deg, #3a86e0 0%, #5d9fe6 32%, #a9cbef 58%, #e9e6df 82%, #faf7f1 100%);
    color: #fff;
  }

  .r-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 45% at 50% 0%, rgba(255, 255, 255, 0.22), transparent 70%);
    pointer-events: none;
  }

  .r-hero-text {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    max-width: 1100px;
    margin-inline: auto;
    text-align: center;
  }

  .r-version {
    display: none;
  }

  .r-hero-title {
    margin: 0;
    font-family: "Anton", Impact, sans-serif;
    font-size: clamp(3rem, 8.6vw, 8.2rem);
    font-weight: 400;
    letter-spacing: 0.005em;
    line-height: 0.9;
    text-shadow: 0 2px 30px rgba(20, 60, 120, 0.18);
    text-transform: uppercase;
  }

  .r-hero-title span {
    display: block;
    animation: r-up 0.9s var(--ease) 0.05s backwards;
  }

  .r-hero-sub {
    max-width: 46ch;
    margin: 0;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.5;
    opacity: 0.95;
    animation: r-up 0.9s var(--ease) 0.2s backwards;
  }

  .r-hero-sub span {
    display: block;
  }

  .r-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 1.15rem 1.4rem 1.15rem 1.8rem;
    border: 0;
    border-radius: 6px;
    background: #eb4b26;
    color: #fff;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.3s;
    animation: r-up 0.9s var(--ease) 0.3s backwards;
  }

  .r-btn::after {
    content: "→";
    display: inline-grid;
    place-items: center;
    width: 1.9em;
    height: 1.9em;
