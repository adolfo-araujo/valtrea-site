---
import AchadosShell from "../../../components/demo/AchadosShell.astro";
import Box3D from "../../../components/demo/Box3D.astro";
import ClayFigure from "../../../components/demo/ClayFigure.astro";
import { finds } from "../../../config/demo-achados";

const money = (value: number) => new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(value);
const letters = ["c", "a", "i", "x", "o", "t", "e"];
---

<AchadosShell title="Caixote · uma caixa te aguarda (demonstração)" path="/demo/achados">
  <section class="h-hero" aria-labelledby="h-title">
    <div class="h-panel">
      <div class="h-scene">
        <h1 class="h-title" id="h-title">
          <span class="sr-only">Uma caixa te aguarda.</span>
          <span class="h-word" aria-hidden="true">
            {letters.map((letter, index) => <span class:list={["h-letter", { "h-letter--gap": index === 4 }]} style={`--i: ${index}`}>{letter}</span>)}
          </span>
        </h1>
        <div class="h-stage" data-k-parallax aria-hidden="true">
          <span class="h-floor"></span>
          <div class="h-fight">
            <ClayFigure pose="pull" className="h-fig h-fig--left" />
            <div class="h-box"><Box3D size="clamp(5.5rem, 11vw, 9rem)" label="caixote" spin={false} depth={1.4} /></div>
            <ClayFigure pose="pull" flip tone="#ff9a4d" className="h-fig h-fig--right" />
            <ClayFigure pose="wave" tone="#f2653a" className="h-fig h-fig--back" />
          </div>
        </div>
      </div>
      <div class="h-foot">
        <div>
          <p class="h-slogan">Uma caixa te aguarda.</p>
          <p class="h-sub">Achados escolhidos um por um, com frete grátis para todo o Brasil.</p>
        </div>
        <a class="k-btn k-btn--ink" href="#caixas">
          Ver as caixas
          <svg class="k-btn-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <a class="h-down" href="#caixas" aria-label="Rolar para as caixas">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
      </a>
    </div>
  </section>

  <section class="k-section" id="caixas" aria-labelledby="caixas-title">
    <div class="k-wrap">
      <header class="k-head reveal">
        <h2 class="k-h2" id="caixas-title">Escolha a sua caixa</h2>
        <p class="k-lead">Frete grátis para todo o Brasil e 7 dias para devolver.</p>
      </header>
      <ul class="k-cards">
        {
          finds.map((item) => (
            <li class="reveal">
              <a class="k-card" href={`/demo/achados/${item.id}`}>
                <span class="k-card-media">
                  <svg viewBox="0 0 200 200" aria-hidden="true"><use href={`#${item.art}`} /></svg>
                </span>
                <span class="k-card-body">
                  <span class="k-card-title">{item.name}</span>
                  <span class="k-card-price">A partir de {money(item.price)}</span>
                </span>
                <span class="k-card-go" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"></path></svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="k-section k-route" id="rota" aria-labelledby="rota-title">
    <div class="k-wrap k-route-grid">
      <div class="k-route-media reveal" aria-hidden="true">
        <div class="k-shelf">
          <span class="k-shelf-board k-shelf-board--top"></span>
          <span class="k-shelf-board k-shelf-board--mid"></span>
          <span class="k-shelf-board k-shelf-board--low"></span>
          <span class="k-shelf-side k-shelf-side--l"></span>
          <span class="k-shelf-side k-shelf-side--r"></span>
          <div class="k-shelf-box k-shelf-box--a"><Box3D size="4.2rem" spin={false} depth={1} /></div>
          <div class="k-shelf-box k-shelf-box--b"><Box3D size="3.4rem" tint="#d7ad7a" spin={false} depth={1} /></div>
          <div class="k-shelf-box k-shelf-box--c"><Box3D size="3.8rem" tint="#c99a66" spin={false} depth={1} /></div>
          <ClayFigure pose="lift" className="k-shelf-fig k-shelf-fig--a" />
          <div class="k-shelf-box k-shelf-box--lift"><Box3D size="3rem" tint="#e0b986" spin={false} depth={1} /></div>
          <ClayFigure pose="pull" tone="#ff9a4d" className="k-shelf-fig k-shelf-fig--b" />
        </div>
      </div>
      <div>
        <header class="k-head reveal">
          <h2 class="k-h2" id="rota-title">Do clique até a sua porta</h2>
          <p class="k-lead">Sem enrolação: é assim que a sua caixa chega.</p>
        </header>
        <div class="k-route-text reveal">
          <p>Você escolhe a sua caixa. Cada uma tem a sua própria página, com tudo o que você precisa saber antes de comprar. Paga do seu jeito, no Pix ou no cartão em até 12x.</p>
          <p>Assim que o pedido sai, o código de rastreio chega no seu e-mail. O frete é grátis para todo o Brasil, e se não gostar, você tem 7 dias para devolver.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="k-section k-deal" id="combinado" aria-labelledby="deal-title">
    <div class="k-wrap">
      <header class="k-head reveal">
        <h2 class="k-h2 k-h2--big" id="deal-title">O nosso combinado</h2>
      </header>
      <ul class="k-deal-grid">
        <li class="reveal"><span class="k-deal-big">R$ 0</span><span class="k-deal-label">de frete, para todo o Brasil</span></li>
        <li class="reveal"><span class="k-deal-big">12x</span><span class="k-deal-label">no cartão, ou Pix</span></li>
        <li class="reveal"><span class="k-deal-big">7 dias</span><span class="k-deal-label">para devolver, sem custo</span></li>
      </ul>
      <p class="k-deal-statement reveal">Sem contador falso, sem estoque inventado, sem letra miúda. Só o produto, o preço e o prazo de verdade.</p>
    </div>
  </section>

  <section class="k-section k-track" id="rastreio" aria-labelledby="track-title">
    <div class="k-wrap k-track-grid">
      <div class="k-track-media reveal" aria-hidden="true">
        <div class="k-pouf-scene">
          <span class="k-pouf"></span>
          <ClayFigure pose="sit" className="k-pouf-fig" />
          <div class="k-pouf-box"><Box3D size="3.6rem" spin={false} depth={1} /></div>
        </div>
      </div>
      <div class="k-track-body">
        <header class="k-head reveal">
          <h2 class="k-h2" id="track-title">Já comprou? Sua caixa tá a caminho.</h2>
          <p class="k-lead">O código de rastreio chega no seu e-mail assim que o pedido sai. Nesta demonstração, qualquer código funciona.</p>
        </header>
        <form class="k-track-form reveal" data-track>
          <label class="sr-only" for="track-code">Código do pedido</label>
          <input id="track-code" name="code" placeholder="Ex.: CX-2048" maxlength="20" required />
          <button class="k-btn k-btn--blue" type="submit">Rastrear pedido</button>
        </form>
        <div class="k-timeline" data-track-result hidden>
          <p>Pedido <b data-track-code></b></p>
          <ol>
            <li data-track-step>Pedido confirmado</li>
            <li data-track-step>Caixa separada</li>
            <li data-track-step>A caminho</li>
            <li data-track-step>Entregue</li>
          </ol>
        </div>
      </div>
    </div>
  </section>
</AchadosShell>

<script>
  const stage = document.querySelector<HTMLElement>("[data-k-parallax]");
  const hero = stage?.closest<HTMLElement>(".h-hero");
  if (stage && hero && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let pointerX = 0;
    let pointerY = 0;
    let currentX = 0;
    let currentY = 0;
    let shift = 0;
    let frame = 0;
    let visible = true;
    const render = () => {
      currentX += (pointerX - currentX) * 0.08;
      currentY += (pointerY - currentY) * 0.08;
      stage.style.transform = `translate3d(${currentX * 18}px, ${currentY * 10 - shift}px, 0)`;
      frame = Math.abs(pointerX - currentX) > 0.001 || Math.abs(pointerY - currentY) > 0.001 ? requestAnimationFrame(render) : 0;
    };
    const kick = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
    }).observe(hero);
    window.addEventListener(
      "scroll",
      () => {
        if (!visible) return;
        shift = Math.min(window.scrollY, window.innerHeight) * 0.12;
        kick();
      },
      { passive: true },
    );
    if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
      hero.addEventListener("pointermove", (event) => {
        pointerX = event.clientX / window.innerWidth - 0.5;
        pointerY = event.clientY / window.innerHeight - 0.5;
        kick();
      });
      hero.addEventListener("pointerleave", () => {
        pointerX = 0;
        pointerY = 0;
        kick();
      });
    }
  }
</script>

<style>
  .h-hero {
    padding: 0.5rem clamp(0.5rem, 1.6vw, 1.25rem) 0;
  }

  .h-panel {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: min(100svh - 1rem, 60rem);
    padding: 5.5rem clamp(1rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2rem);
    overflow: clip;
    background: #fff;
  }

  .h-scene {
    --fs: clamp(4.5rem, 21vw, 19rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: 1rem 1.5rem;
  }

  .h-title {
    position: relative;
    z-index: 0;
    margin: 0;
    pointer-events: none;
  }

  .h-word {
    display: flex;
    padding-right: 0.065em;
    color: #000;
    font: 900 var(--fs) / 0.8 "Archivo", sans-serif;
    letter-spacing: -0.065em;
    white-space: nowrap;
  }

  .h-letter {
    display: inline-block;
    animation: h-letter 0.9s var(--ease) backwards;
    animation-delay: calc(0.05s + var(--i) * 0.05s);
  }

  .h-letter--gap {
    visibility: hidden;
  }

  .h-stage {
    position: relative;
    z-index: 1;
    width: min(86vw, 40rem);
    margin-top: calc(var(--fs) * -0.5);
    will-change: transform;
    animation: h-stage 1.1s var(--ease) 0.3s backwards;
  }

  .h-floor {
    position: absolute;
    right: 8%;
    bottom: -2%;
    left: 8%;
    height: 14%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.22), transparent);
  }

  .h-fight {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 0;
    aspect-ratio: 2.1;
  }

  :global(.h-fig) {
    width: 100%;
    max-width: 13rem;
  }

  :global(.h-fig--left) {
    justify-self: end;
    margin-right: -2.4rem;
  }

  :global(.h-fig--right) {
    justify-self: start;
    margin-left: -2.4rem;
  }

  :global(.h-fig--back) {
    position: absolute;
    top: -12%;
    left: 50%;
    z-index: -1;
    width: 26%;
    max-width: 9rem;
    transform: translateX(-10%);
    opacity: 0.95;
  }

  .h-box {
    position: relative;
    z-index: 1;
    margin-bottom: 18%;
    animation: h-tug 2.6s ease-in-out infinite;
  }

  .h-foot {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1rem;
  }

  .h-slogan {
    margin: 0;
    font: 800 clamp(1.5rem, 5vw, 2.25rem) / 1 "Archivo", sans-serif;
    letter-spacing: -0.035em;
  }

  .h-sub {
    max-width: 24rem;
    margin: 0.5rem 0 0;
    color: #5c5c5c;
  }

  .h-down {
    display: none;
  }

  :global(.k-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.5rem;
    padding: 0.95rem 1.6rem;
    border: 0;
    border-radius: 999px;
    font: 700 1.0625rem/1 "Archivo", sans-serif;
    letter-spacing: -0.01em;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.35s var(--ease),
      background-color 0.2s ease,
      box-shadow 0.35s var(--ease);
  }

  :global(.k-btn:active) {
    transform: scale(0.97);
  }

  :global(.k-btn svg) {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s var(--ease);
  }

  :global(.k-btn--ink) {
    background: #000;
    color: #fff;
  }

  :global(.k-btn--blue) {
    background: #0048ff;
    box-shadow: 0 10px 30px -10px rgba(0, 72, 255, 0.7);
    color: #fff;
  }

  @media (hover: hover) {
    :global(.k-btn--ink:hover) {
      background: #0048ff;
      transform: translateY(-2px);
    }

    :global(.k-btn--ink:hover svg) {
      transform: translateX(3px);
    }

    :global(.k-btn--blue:hover) {
      background: #0036c2;
      transform: translateY(-2px);
    }
  }

  .k-section {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .k-head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .k-h2 {
    margin: 0;
    font: 800 clamp(2rem, 7vw, 3.5rem) / 0.98 "Archivo", sans-serif;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .k-h2--big {
    font-size: clamp(2.375rem, 8vw, 4.25rem);
  }

  .k-lead {
    margin: 1rem 0 0;
    color: #9a9a9a;
    font-size: clamp(1.0625rem, 2.4vw, 1.25rem);
    text-wrap: pretty;
  }

  .k-cards {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .k-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    color: #000;
    text-decoration: none;
  }

  .k-card-media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 1.5rem;
    background: #f4f4f2;
  }

  .k-card-media svg {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 0.7s var(--ease);
  }

  .k-card-body {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 3.5rem 0 0.25rem;
  }

  .k-card-title {
    font: 700 1.25rem/1.15 "Archivo", sans-serif;
    letter-spacing: -0.02em;
  }

  .k-card-price {
    color: #5c5c5c;
    font-weight: 500;
  }

  .k-card-go {
    position: absolute;
    right: 0;
    bottom: 0.15rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid #e4e4e1;
    border-radius: 50%;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.45s var(--ease);
  }

  .k-card-go svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  @media (hover: hover) {
    .k-card:hover .k-card-media svg {
      transform: scale(1.04);
    }

    .k-card:hover .k-card-go {
      border-color: #0048ff;
      background: #0048ff;
      color: #fff;
      transform: rotate(45deg);
    }
  }

  .k-route-grid {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .k-route-text {
    max-width: 34rem;
    color: #5c5c5c;
    font-size: clamp(1.0625rem, 2.2vw, 1.1875rem);
    line-height: 1.65;
  }

  .k-route-text p {
    margin: 0;
  }

  .k-route-text p + p {
    margin-top: 1rem;
  }

  .k-shelf {
    position: relative;
    aspect-ratio: 1.25;
    border-radius: 2rem;
    background: radial-gradient(70% 70% at 50% 40%, #fff, #f4f4f2);
  }

  .k-shelf-board {
    position: absolute;
    left: 14%;
    width: 52%;
    height: 3%;
    border-radius: 4px;
    background: linear-gradient(#e8c99d, #b98654);
    box-shadow: 0 10px 14px -8px rgba(0, 0, 0, 0.35);
  }

  .k-shelf-board--top {
    top: 26%;
  }

  .k-shelf-board--mid {
    top: 52%;
  }

  .k-shelf-board--low {
    top: 78%;
  }

  .k-shelf-side {
    position: absolute;
    top: 10%;
    bottom: 10%;
    width: 2.4%;
    border-radius: 4px;
    background: linear-gradient(90deg, #c99a66, #9c6b3a);
  }

  .k-shelf-side--l {
    left: 13%;
  }

  .k-shelf-side--r {
    left: 64.6%;
  }

  .k-shelf-box {
    position: absolute;
  }

  .k-shelf-box--a {
    top: 9%;
    left: 20%;
  }

  .k-shelf-box--b {
    top: 37%;
    left: 40%;
  }

  .k-shelf-box--c {
    top: 62%;
    left: 22%;
  }

  .k-shelf-box--lift {
    top: 22%;
    right: 12%;
    animation: h-bob 2.4s ease-in-out infinite;
  }

  :global(.k-shelf-fig) {
    position: absolute;
    bottom: 6%;
    width: 24%;
  }

  :global(.k-shelf-fig--a) {
    right: 10%;
  }

  :global(.k-shelf-fig--b) {
    left: 2%;
    width: 20%;
  }

  .k-deal {
    border-top: 1px solid #e4e4e1;
  }

  .k-deal-grid {
    display: grid;
    max-width: 50rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .k-deal-grid li {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.75rem;
    border-top: 1px solid #e4e4e1;
  }

  .k-deal-grid li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .k-deal-big {
    font: 900 clamp(2.5rem, 9vw, 3.75rem) / 0.9 "Archivo", sans-serif;
    letter-spacing: -0.05em;
  }

  .k-deal-grid li:nth-child(2) .k-deal-big {
    color: #0048ff;
  }

  .k-deal-label {
    color: #5c5c5c;
    font-size: 0.9375rem;
  }

  .k-deal-statement {
    max-width: 40rem;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0 auto;
    font: 700 clamp(1.5rem, 4.6vw, 2.5rem) / 1.12 "Archivo", sans-serif;
    letter-spacing: -0.03em;
    text-align: right;
    text-wrap: balance;
  }

  .k-track {
    border-top: 1px solid #e4e4e1;
  }

  .k-track-grid {
    display: grid;
    align-items: center;
    gap: 1.5rem;
  }

  .k-track-media {
    justify-self: center;
    width: min(80vw, 30rem);
  }

  .k-pouf-scene {
    position: relative;
    aspect-ratio: 1;
  }

  .k-pouf {
    position: absolute;
    bottom: 10%;
    left: 22%;
    width: 46%;
    height: 26%;
    border-radius: 48% 48% 40% 40% / 60% 60% 40% 40%;
    background: radial-gradient(80% 70% at 40% 30%, #6a8dff, #0036c2);
    box-shadow: 0 30px 30px -20px rgba(0, 0, 0, 0.35);
  }

  :global(.k-pouf-fig) {
    position: absolute;
    bottom: 22%;
    left: 24%;
    width: 46%;
  }

  .k-pouf-box {
    position: absolute;
    right: 6%;
    bottom: 10%;
  }

  .k-track-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .k-track-form input {
    flex: 1 1 14rem;
    min-height: 3.5rem;
    padding: 0 1.2rem;
    border: 1px solid #e4e4e1;
    border-radius: 999px;
    font: inherit;
  }

  .k-track-form input:focus {
    outline: none;
    border-color: #0048ff;
    box-shadow: 0 0 0 1px #0048ff;
  }

  .k-timeline {
    margin-top: 1.5rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid #e4e4e1;
    border-radius: 1.5rem;
  }

  .k-timeline p {
    margin: 0 0 0.8rem;
  }

  .k-timeline ol {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .k-timeline li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: #9a9a9a;
  }

  .k-timeline li::before {
    content: "";
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid #e4e4e1;
    border-radius: 50%;
  }

  .k-timeline li:global(.is-done) {
    color: #000;
  }

  .k-timeline li:global(.is-done)::before {
    border-color: #0048ff;
    background: #0048ff;
  }

  @keyframes h-letter {
    from {
      opacity: 0;
      transform: translateY(30%);
    }
  }

  @keyframes h-stage {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }

  @keyframes h-tug {
    0%,
