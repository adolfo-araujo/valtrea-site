---
import { existsSync } from "node:fs";
import { join } from "node:path";
import DemoFrame from "../../components/demo/DemoFrame.astro";

const money = (value: number) => new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(value);
const photo = (name: string) => (existsSync(join(process.cwd(), "public", "demo", "cardapio", name)) ? `/demo/cardapio/${name}` : "");

interface Item {
  id: string;
  name: string;
  text: string;
  price: number;
  old?: number;
  cat: string;
  art: string;
  badge?: string;
  options?: string[];
}

const burger = ["ponto", "turbo", "molho"];
const items: Item[] = [
  { id: "classico", name: "Smash clássico", text: "Dois smash de 80 g, cheddar inglês, cebola na chapa e maionese da casa no brioche.", price: 29, cat: "burgers", art: "burger", options: burger },
  { id: "bacon", name: "Bacon jam", text: "Smash duplo, geleia de bacon, cheddar, picles e barbecue defumado.", price: 34, cat: "burgers", art: "burger-bacon", options: burger },
  { id: "trufado", name: "Trufado", text: "Blend de 160 g, queijo brie, cogumelos salteados e maionese trufada.", price: 38, cat: "burgers", art: "burger-brie", badge: "Novo", options: burger },
  { id: "picante", name: "Chapa picante", text: "Smash duplo, pepper jack, jalapeño, cebola crispy e maionese de chipotle.", price: 33, cat: "burgers", art: "burger-hot", options: burger },
  { id: "frango", name: "Crispy chicken", text: "Sobrecoxa empanada crocante, alface americana, picles e mostarda e mel.", price: 31, cat: "burgers", art: "burger-chicken", options: ["molho"] },
  { id: "veg", name: "Smash da horta", text: "Burger de grão-de-bico e beterraba, queijo prato, tomate e aioli de ervas.", price: 30, cat: "burgers", art: "burger-veg", options: ["molho"] },
  { id: "combo-classico", name: "Combo clássico", text: "Smash clássico, fritas da casa e bebida em lata.", price: 42, old: 49, cat: "combos", art: "combo", options: ["ponto", "lata"] },
  { id: "combo-dupla", name: "Combo dupla", text: "Dois smash clássicos, fritas grandes, onion rings e duas bebidas.", price: 79, old: 92, cat: "combos", art: "combo", options: ["ponto", "lata"] },
  { id: "fritas", name: "Fritas da casa", text: "Batata rústica com casca, alecrim e sal defumado.", price: 16, cat: "lados", art: "fries" },
  { id: "fritas-cheddar", name: "Fritas cheddar e bacon", text: "Fritas da casa cobertas de cheddar cremoso e farofa de bacon.", price: 24, cat: "lados", art: "fries-cheddar" },
  { id: "onion", name: "Onion rings", text: "Anéis de cebola empanados na cerveja, com barbecue.", price: 19, cat: "lados", art: "rings" },
  { id: "lata", name: "Refrigerante lata", text: "350 ml, gelado. Cola, guaraná ou limão.", price: 7, cat: "bebidas", art: "can", options: ["lata"] },
  { id: "limonada", name: "Limonada da casa", text: "Limão, hortelã e gengibre. 500 ml.", price: 11, cat: "bebidas", art: "lemonade" },
  { id: "shake", name: "Milkshake maltado", text: "Sorvete de baunilha batido com chocolate maltado crocante. 400 ml.", price: 22, cat: "bebidas", art: "shake" },
  { id: "brownie", name: "Brownie na chapa", text: "Brownie quente com bola de sorvete e calda de doce de leite.", price: 18, cat: "doces", art: "brownie" },
  { id: "cookie", name: "Cookie gigante", text: "Massa amanteigada com gotas de chocolate meio amargo.", price: 12, cat: "doces", art: "cookie" },
];
const categories = [
  { id: "burgers", label: "Burgers" },
  { id: "combos", label: "Combos" },
  { id: "lados", label: "Acompanhamentos" },
  { id: "bebidas", label: "Bebidas" },
  { id: "doces", label: "Sobremesas" },
];
const top = ["classico", "bacon", "combo-classico", "shake"].map((id) => items.find((item) => item.id === id)).filter((item): item is Item => Boolean(item));
const discount = (item: Item) => (item.old ? `-${Math.round((1 - item.price / item.old) * 100)}%` : "");
const areas = [
  { name: "Pinheiros", fee: 5 },
  { name: "Vila Madalena", fee: 6 },
  { name: "Jardins", fee: 8 },
  { name: "Butantã", fee: 9 },
  { name: "Perdizes", fee: 9 },
  { name: "Lapa", fee: 11 },
];
const hours = [
  ["Segunda", "fechado"],
  ["Terça", "18:00 – 23:00"],
  ["Quarta", "18:00 – 23:00"],
  ["Quinta", "18:00 – 23:00"],
  ["Sexta", "18:00 – 00:30"],
  ["Sábado", "18:00 – 00:30"],
  ["Domingo", "18:00 – 23:30"],
];
const store = {
  products: items.map(({ id, name, price, options }) => ({ id, name, price, ...(options ? { options } : {}) })),
  groups: [
    { id: "ponto", label: "Ponto da carne", type: "single" as const, required: true, choices: [{ label: "Ao ponto" }, { label: "Bem passado" }] },
    {
      id: "turbo",
      label: "Turbine o burger",
      type: "multi" as const,
      choices: [
        { label: "Carne smash extra", price: 9 },
        { label: "Bacon crocante", price: 6 },
        { label: "Cheddar extra", price: 4 },
        { label: "Cebola caramelizada", price: 4 },
        { label: "Ovo na chapa", price: 3 },
        { label: "Picles da casa", price: 2 },
      ],
    },
    {
      id: "molho",
      label: "Molho extra",
      type: "multi" as const,
      choices: [
        { label: "Maionese da casa", price: 3 },
        { label: "Barbecue defumado", price: 3 },
        { label: "Mostarda e mel", price: 3 },
      ],
    },
    { id: "lata", label: "Sabor da lata", type: "single" as const, required: true, choices: [{ label: "Cola" }, { label: "Guaraná" }, { label: "Limão" }] },
  ],
  modes: ["entrega", "retirada"] as ("entrega" | "retirada")[],
  areas,
  minDelivery: 30,
  payments: ["Pix", "Cartão na entrega", "Dinheiro"],
  pickupAddress: "Rua dos Pinheiros, 777 · Pinheiros (fictício)",
};
const hero = photo("hero.jpg");
---

<DemoFrame
  brand="Fornalha Burger"
  title="Fornalha · smash burger (demonstração)"
  description="Cardápio de demonstração feito pela Valtrea: monte o pedido, escolha entrega ou retirada e envie pelo WhatsApp."
  path="/demo/cardapio"
  themeColor="#ECEBE8"
  bodyClass="cardapio"
  store={store}
>
  <header class="c-nav" data-c-nav>
    <div class="c-nav-inner">
      <a class="c-logo" href="#topo" aria-label="Fornalha, início"><span class="c-logo-ring" aria-hidden="true"></span>Fornalha</a>
      <nav class="c-links" aria-label="Seções">
        <a href="#cardapio">Cardápio</a>
        <a href="#como">Como pedir</a>
        <a href="#info">Horário e entrega</a>
      </nav>
      <button class="c-bag" type="button" data-bag-open>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8Z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg>
        <span>Sacola</span>
        <b data-bag-count hidden>0</b>
      </button>
    </div>
  </header>

  <section class="c-hero" id="topo" aria-labelledby="c-hero-title">
    <div class="c-hero-card" data-c-hero>
      <div class="c-grooves" aria-hidden="true"></div>
      <div class="c-hero-text">
        <p class="c-status" data-c-status><span class="c-status-dot"></span><span data-c-status-text>Verificando horário…</span></p>
        <h1 id="c-hero-title" class="c-hero-title" data-c-title>
          <span class="c-line"><span>Smash que</span></span>
          <span class="c-line"><span>estala<em>.</em></span></span>
        </h1>
        <p class="c-hero-sub">Carne prensada na chapa quente, borda crocante e cheddar escorrendo. Monte o seu pedido aqui e ele chega pronto no WhatsApp.</p>
        <div class="c-hero-ctas">
          <a class="c-btn c-btn--dark" href="#cardapio">Ver cardápio</a>
          <span class="c-hero-note">Entrega em <b>35–50 min</b></span>
        </div>
      </div>
      <div class="c-disc-wrap" aria-hidden="true">
        <div class="c-disc" data-c-disc>
          <div class="c-plate">
            {
              hero ? (
                <img src={hero} alt="" />
              ) : (
                <svg viewBox="0 0 400 400"><use href="#plate" /></svg>
              )
            }
          </div>
          <span class="c-plate-edge"></span>
        </div>
      </div>
      <p class="c-hero-title c-hero-title--light" aria-hidden="true" data-c-title-light>
        <span class="c-line"><span>Smash que</span></span>
        <span class="c-line"><span>estala<em>.</em></span></span>
      </p>
    </div>
  </section>

  <section class="c-section" aria-labelledby="c-top-title">
    <div class="c-wrap">
      <div class="c-head reveal">
        <h2 id="c-top-title" class="c-title">Os mais pedidos<em>.</em></h2>
        <p class="c-lead">O que mais sai da chapa nas noites de sexta.</p>
      </div>
      <div class="c-top">
        {
          top.map((item, index) => (
            <article class="c-top-card reveal">
              <button class="c-top-photo" type="button" data-add={item.id} aria-label={`Montar ${item.name}`}>
                <span class="c-photo">
                  {photo(`${item.id}.jpg`) ? <img src={photo(`${item.id}.jpg`)} alt={item.name} loading="lazy" /> : <svg viewBox="0 0 200 200" aria-hidden="true"><use href={`#food-${item.art}`} /></svg>}
                </span>
                {item.old && <span class="c-badge">{discount(item)}</span>}
                <span class="c-rank">{index + 1}</span>
              </button>
              <div class="c-top-info">
                <h3>{item.name}</h3>
                <span class="c-price">{item.old && <del>{money(item.old)}</del>}{money(item.price)}</span>
                <button class="c-add" type="button" data-add={item.id} aria-label={`Adicionar ${item.name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                </button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="c-section c-menu" id="cardapio" aria-labelledby="c-menu-title">
    <div class="c-wrap">
      <div class="c-head reveal">
        <h2 id="c-menu-title" class="c-title">Cardápio<em>.</em></h2>
        <p class="c-lead">Toque no item para escolher o ponto, os adicionais e deixar uma observação.</p>
      </div>
    </div>
    <div class="c-tabs-wrap" data-c-tabs-wrap>
      <div class="c-wrap">
        <nav class="c-tabs" aria-label="Categorias do cardápio" data-c-tabs>
          <span class="c-tabs-pill" data-c-pill></span>
          {categories.map((category, index) => <a href={`#cat-${category.id}`} data-c-tab={category.id} aria-current={index === 0 ? "true" : "false"}>{category.label}</a>)}
        </nav>
      </div>
    </div>
    <div class="c-wrap">
      {
        categories.map((category) => {
          const list = items.filter((item) => item.cat === category.id);
          return (
            <section class="c-cat" id={`cat-${category.id}`} data-c-cat={category.id} aria-labelledby={`t-${category.id}`}>
              <h3 class="c-cat-title" id={`t-${category.id}`}>
                {category.label} <small>{list.length} itens</small>
              </h3>
              <ul class="c-items">
                {list.map((item) => (
                  <li class="c-item reveal">
                    <div class="c-item-text">
                      <h4><button type="button" data-add={item.id}>{item.name}</button></h4>
                      <p>{item.text}</p>
                      <span class="c-price">{item.old && <del>{money(item.old)}</del>}{money(item.price)}</span>
                    </div>
                    <div class="c-item-photo">
                      <span class="c-photo">
                        {photo(`${item.id}.jpg`) ? <img src={photo(`${item.id}.jpg`)} alt={item.name} loading="lazy" /> : <svg viewBox="0 0 200 200" aria-hidden="true"><use href={`#food-${item.art}`} /></svg>}
                      </span>
                      {item.old && <span class="c-badge">{discount(item)}</span>}
                      {item.badge && <span class="c-badge c-badge--hot">{item.badge}</span>}
                      <span class="c-add" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg>
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </section>

  <section class="c-section c-steps" id="como" aria-labelledby="c-steps-title">
    <div class="c-wrap">
      <div class="c-head reveal">
        <h2 id="c-steps-title" class="c-title">Três toques e tá na chapa<em>.</em></h2>
      </div>
      <div class="c-steps-box">
        <svg class="c-thread" viewBox="0 0 1000 160" preserveAspectRatio="none" aria-hidden="true" data-c-thread><path d="M20 120 C 200 10, 320 150, 500 80 S 820 20, 980 110"></path></svg>
        <ol class="c-steps-list">
          <li class="reveal"><span>1</span><h3>Monte</h3><p>Escolha os itens, o ponto da carne e os adicionais.</p></li>
          <li class="reveal"><span>2</span><h3>Confira</h3><p>Entrega ou retirada, bairro e forma de pagamento. O total já vem com a taxa.</p></li>
          <li class="reveal"><span>3</span><h3>Envie</h3><p>O pedido aparece pronto para mandar no WhatsApp e a casa confirma em minutos.</p></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="c-section c-info" id="info" aria-labelledby="c-info-title">
    <div class="c-wrap c-info-grid">
      <div class="reveal">
        <h2 id="c-info-title" class="c-title">Horário e entrega<em>.</em></h2>
        <p class="c-lead c-lead--gap"><b>Rua dos Pinheiros, 777 · Pinheiros</b> (endereço fictício). Retirada no balcão em 20 min. Pedido mínimo para entrega de {money(30)}.</p>
        <button class="c-btn c-btn--dark" type="button" data-bag-open>Montar meu pedido</button>
      </div>
      <div class="c-cards">
        <div class="c-card reveal">
          <h3>Funcionamento</h3>
          <ul class="c-rows">{hours.map(([day, time]) => <li data-c-day={day}><span>{day}</span><span>{time}</span></li>)}</ul>
        </div>
        <div class="c-card reveal">
          <h3>Taxa por bairro</h3>
          <ul class="c-rows">{areas.map((area) => <li><span>{area.name}</span><span>{money(area.fee)}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <svg width="0" height="0" class="c-defs" aria-hidden="true">
    <defs>
      <radialGradient id="f-bun" cx="0.45" cy="0.3" r="0.8">
        <stop offset="0" stop-color="#f3b35e" />
        <stop offset="0.6" stop-color="#d98a3a" />
        <stop offset="1" stop-color="#a95d1e" />
      </radialGradient>
      <linearGradient id="f-meat" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#6a3519" />
        <stop offset="1" stop-color="#3b1c0b" />
      </linearGradient>
      <linearGradient id="f-cheese" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffd24a" />
        <stop offset="1" stop-color="#f2a915" />
      </linearGradient>
      <linearGradient id="f-fry" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#f6c656" />
        <stop offset="1" stop-color="#e2a43a" />
      </linearGradient>
      <radialGradient id="f-bg" cx="0.5" cy="0.4" r="0.75">
        <stop offset="0" stop-color="#fbfaf7" />
        <stop offset="1" stop-color="#e6e4df" />
      </radialGradient>
      <radialGradient id="f-shadow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#000" stop-opacity="0.28" />
        <stop offset="1" stop-color="#000" stop-opacity="0" />
      </radialGradient>

      <symbol id="food-burger-base" viewBox="0 0 200 200">
        <rect width="200" height="200" fill="url(#f-bg)" />
        <ellipse cx="100" cy="166" rx="74" ry="10" fill="url(#f-shadow)" />
        <path d="M34 140c0 14 14 22 66 22s66-8 66-22c0-6-8-8-66-8s-66 2-66 8Z" fill="url(#f-bun)" />
        <path d="M30 124c4-6 16-8 70-8s66 2 70 8c4 6-6 12-70 12s-74-6-70-12Z" fill="url(#f-meat)" />
        <path d="M30 104c4-6 16-8 70-8s66 2 70 8c4 6-6 12-70 12s-74-6-70-12Z" fill="url(#f-meat)" />
        <path d="M38 98l124 0-6 14-10-6-12 12-10-8-12 10-14-10-12 10-12-9-12 10-12-8-10 6Z" fill="url(#f-cheese)" />
        <path d="M34 92c0-40 30-58 66-58s66 18 66 58Z" fill="url(#f-bun)" />
        <g fill="#fff3d6">
          <ellipse cx="80" cy="56" rx="4" ry="2" transform="rotate(-20 80 56)" />
          <ellipse cx="100" cy="48" rx="4" ry="2" />
          <ellipse cx="122" cy="58" rx="4" ry="2" transform="rotate(20 122 58)" />
          <ellipse cx="94" cy="68" rx="4" ry="2" transform="rotate(10 94 68)" />
          <ellipse cx="140" cy="72" rx="4" ry="2" transform="rotate(30 140 72)" />
          <ellipse cx="62" cy="74" rx="4" ry="2" transform="rotate(-30 62 74)" />
        </g>
        <path d="M60 50c14-10 40-12 56-6" stroke="#fff" stroke-opacity="0.35" stroke-width="5" fill="none" stroke-linecap="round" />
      </symbol>
      <symbol id="food-burger" viewBox="0 0 200 200"><use href="#food-burger-base" /></symbol>
      <symbol id="food-burger-bacon" viewBox="0 0 200 200">
        <use href="#food-burger-base" />
        <path d="M32 120c20-8 40 6 60-2s40 6 76-2l2 8c-30 8-48-6-74 2s-44-6-64 2Z" fill="#b2391f" />
      </symbol>
      <symbol id="food-burger-brie" viewBox="0 0 200 200">
        <use href="#food-burger-base" />
        <path d="M40 100h120l-8 10H48Z" fill="#fbf3dc" />
        <circle cx="70" cy="114" r="6" fill="#8a6a4a" />
        <circle cx="122" cy="114" r="6" fill="#8a6a4a" />
      </symbol>
      <symbol id="food-burger-hot" viewBox="0 0 200 200">
        <use href="#food-burger-base" />
        <g fill="#3f9b3a"><circle cx="64" cy="114" r="6" /><circle cx="100" cy="116" r="6" /><circle cx="136" cy="114" r="6" /></g>
        <path d="M150 40c10-8 20 0 14 10" stroke="#d62a14" stroke-width="5" fill="none" stroke-linecap="round" />
      </symbol>
      <symbol id="food-burger-chicken" viewBox="0 0 200 200">
        <use href="#food-burger-base" />
        <path d="M28 104c6-10 30-12 72-12s66 4 72 12c4 8-6 22-72 22s-76-12-72-22Z" fill="#d79a3b" />
        <path d="M40 98c40 10 80 10 120 0" stroke="#7fbf3f" stroke-width="7" fill="none" />
      </symbol>
      <symbol id="food-burger-veg" viewBox="0 0 200 200">
        <use href="#food-burger-base" />
        <path d="M30 104c4-6 16-8 70-8s66 2 70 8c4 6-6 12-70 12s-74-6-70-12Z" fill="#8a2f4a" />
        <path d="M40 96h120" stroke="#e8432e" stroke-width="7" />
      </symbol>
      <symbol id="food-fries-art" viewBox="0 0 200 200">
        <g fill="url(#f-fry)" stroke="#c98a24" stroke-width="1">
          <rect x="70" y="50" width="12" height="70" rx="3" transform="rotate(-10 76 85)" />
          <rect x="88" y="40" width="12" height="80" rx="3" />
          <rect x="104" y="46" width="12" height="74" rx="3" transform="rotate(8 110 83)" />
          <rect x="120" y="56" width="12" height="64" rx="3" transform="rotate(16 126 88)" />
          <rect x="78" y="60" width="12" height="60" rx="3" transform="rotate(4 84 90)" />
        </g>
        <path d="M60 100h80l-10 74H70Z" fill="#d62a14" />
        <path d="M66 100h68" stroke="#fff" stroke-width="4" />
        <circle cx="100" cy="138" r="14" fill="#ffd60a" />
      </symbol>
      <symbol id="food-fries" viewBox="0 0 200 200">
        <rect width="200" height="200" fill="url(#f-bg)" />
        <ellipse cx="100" cy="176" rx="50" ry="8" fill="url(#f-shadow)" />
        <use href="#food-fries-art" />
      </symbol>
      <symbol id="food-fries-cheddar" viewBox="0 0 200 200">
        <use href="#food-fries" />
        <path d="M66 70c10-12 24 6 34-6s24 8 36-4c4 14-6 26-34 28s-40-6-36-18Z" fill="url(#f-cheese)" />
        <g fill="#8c2e16"><circle cx="86" cy="76" r="3" /><circle cx="108" cy="70" r="3" /><circle cx="122" cy="80" r="3" /></g>
      </symbol>
      <symbol id="food-rings" viewBox="0 0 200 200">
        <rect width="200" height="200" fill="url(#f-bg)" />
        <ellipse cx="100" cy="160" rx="70" ry="10" fill="url(#f-shadow)" />
        <g fill="none" stroke="url(#f-fry)" stroke-width="16">
          <ellipse cx="78" cy="118" rx="34" ry="22" />
          <ellipse cx="124" cy="108" rx="34" ry="22" />
          <ellipse cx="100" cy="86" rx="32" ry="20" />
        </g>
      </symbol>
      <symbol id="food-can" viewBox="0 0 200 200">
        <rect width="200" height="200" fill="url(#f-bg)" />
        <ellipse cx="100" cy="172" rx="40" ry="7" fill="url(#f-shadow)" />
        <rect x="70" y="44" width="60" height="128" rx="10" fill="#d62a14" />
        <rect x="70" y="44" width="60" height="128" rx="10" fill="url(#f-can-shine)" />
        <rect x="74" y="36" width="52" height="12" rx="4" fill="#c9cdd3" />
        <path d="M76 110c12-10 36-10 48 0" stroke="#fff" stroke-width="5" fill="none" />
