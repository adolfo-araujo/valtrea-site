<script>
  const nav = document.querySelector<HTMLElement>("[data-c-nav]");
  const ribbon = document.querySelector<HTMLElement>(".demo-ribbon");
  const markNav = () => {
    nav?.style.setProperty("--ribbon", `${Math.max(0, (ribbon?.offsetHeight ?? 0) - window.scrollY)}px`);
    nav?.classList.toggle("is-scrolled", window.scrollY > 30);
  };
  window.addEventListener("scroll", markNav, { passive: true });
  markNav();

  const status = document.querySelector<HTMLElement>("[data-c-status]");
  const statusText = document.querySelector<HTMLElement>("[data-c-status-text]");
  const schedule: Record<number, [number, number] | null> = { 0: [18, 23.5], 1: null, 2: [18, 23], 3: [18, 23], 4: [18, 23], 5: [18, 24.5], 6: [18, 24.5] };
  const names = ["Domingo", "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado"];
  const pretty = (hour: number) => {
    const wrapped = hour % 24;
    return `${String(Math.floor(wrapped)).padStart(2, "0")}:${wrapped % 1 ? "30" : "00"}`;
  };
  const parts = new Intl.DateTimeFormat("en-US", { timeZone: "America/Sao_Paulo", weekday: "short", hour: "numeric", minute: "numeric", hourCycle: "h23" }).formatToParts(new Date());
  const day = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].indexOf(parts.find((part) => part.type === "weekday")?.value ?? "");
  const now = Number(parts.find((part) => part.type === "hour")?.value ?? 0) + Number(parts.find((part) => part.type === "minute")?.value ?? 0) / 60;
  const today = schedule[day] ?? null;
  const yesterday = schedule[(day + 6) % 7] ?? null;
  let open = false;
  let closesAt = 0;
  if (today && now >= today[0] && now < Math.min(24, today[1])) {
    open = true;
    closesAt = today[1];
  } else if (yesterday && yesterday[1] > 24 && now < yesterday[1] - 24) {
    open = true;
    closesAt = yesterday[1];
  }
  if (status && statusText) {
    status.classList.toggle("is-open", open);
    if (open) statusText.textContent = `Aberto até ${pretty(closesAt)}`;
    else if (today && now < today[0]) statusText.textContent = `Fechado · abre hoje às ${pretty(today[0])}`;
    else {
      let next = 1;
      while (next < 7 && !schedule[(day + next) % 7]) next++;
      const target = schedule[(day + next) % 7];
      statusText.textContent = target ? `Fechado · abre ${next === 1 ? "amanhã" : names[(day + next) % 7]?.toLowerCase()} às ${pretty(target[0])}` : "Fechado";
    }
  }
  document.querySelector(`[data-c-day="${names[day]}"]`)?.classList.add("is-today");

  const hero = document.querySelector<HTMLElement>("[data-c-hero]");
  const title = document.querySelector<HTMLElement>("[data-c-title]");
  const light = document.querySelector<HTMLElement>("[data-c-title-light]");
  const disc = document.querySelector<HTMLElement>("[data-c-disc]");
  const placeLight = () => {
    if (!hero || !title || !light || !disc) return;
    const box = hero.getBoundingClientRect();
    const words = title.getBoundingClientRect();
    const round = disc.getBoundingClientRect();
    light.style.left = `${words.left - box.left}px`;
    light.style.top = `${words.top - box.top}px`;
    light.style.width = `${words.width}px`;
    const radius = round.width / 2;
    light.style.clipPath = `circle(${radius}px at ${round.left - words.left + radius}px ${round.top - words.top + radius}px)`;
  };
  placeLight();
  window.addEventListener("resize", placeLight);
  void document.fonts.ready.then(placeLight);

  const tabsWrap = document.querySelector<HTMLElement>("[data-c-tabs-wrap]");
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>("[data-c-tab]")];
  const pill = document.querySelector<HTMLElement>("[data-c-pill]");
  const movePill = (tab: HTMLElement) => {
    if (!pill) return;
    pill.style.width = `${tab.offsetWidth}px`;
    pill.style.transform = `translateX(${tab.offsetLeft}px)`;
  };
  const setTab = (id: string) => {
    tabs.forEach((tab) => {
      const on = tab.dataset.cTab === id;
      tab.setAttribute("aria-current", String(on));
      if (on) {
        movePill(tab);
        tab.parentElement?.scrollTo({ left: tab.offsetLeft - 40, behavior: "smooth" });
      }
    });
  };
  const firstTab = tabs[0];
  if (firstTab) movePill(firstTab);
  void document.fonts.ready.then(() => {
    const current = tabs.find((tab) => tab.getAttribute("aria-current") === "true");
    if (current) movePill(current);
  });
  if ("IntersectionObserver" in window) {
    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setTab((entry.target as HTMLElement).dataset.cCat ?? "");
        }
      },
      { rootMargin: "-35% 0px -60% 0px" },
    );
    document.querySelectorAll<HTMLElement>("[data-c-cat]").forEach((section) => watcher.observe(section));
    if (tabsWrap) {
      const stuck = new IntersectionObserver(([entry]) => tabsWrap.classList.toggle("is-stuck", !(entry?.isIntersecting ?? true)), { rootMargin: "-90px 0px 0px 0px", threshold: 1 });
      const marker = document.createElement("span");
      tabsWrap.before(marker);
      stuck.observe(marker);
    }
  }

  const thread = document.querySelector<SVGSVGElement>("[data-c-thread]");
  if (thread && "IntersectionObserver" in window) {
    const drawer = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting) return;
      thread.classList.add("is-drawn");
      drawer.disconnect();
    }, { threshold: 0.4 });
    drawer.observe(thread);
  }

  const revealed = document.querySelectorAll<HTMLElement>(".reveal");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-on");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.1 },
    );
    revealed.forEach((element, index) => {
      element.style.transitionDelay = `${(index % 4) * 0.07}s`;
      observer.observe(element);
    });
  } else {
    revealed.forEach((element) => element.classList.add("is-on"));
  }
</script>

