              </button>
              <div class="p-pd-text">
                <p class="p-eye">{product.eye}</p>
                <h3 class="p-pd-name">{product.name}</h3>
                <p class="p-pd-desc">{product.text}</p>
                <ul class="p-chips">{product.chips.map((chip) => <li>{chip}</li>)}</ul>
                <div class="p-pd-buy">
                  <p class="p-price"><strong>{money(product.price)}</strong><small>{pix(product.price)} no Pix</small></p>
                  <div class="p-pd-actions">
                    <button class="p-btn p-btn--lime" type="button" data-add={product.id}>{product.sizes ? "Escolher tamanho" : "Adicionar"}</button>
                    <a class="p-btn p-btn--line" href="#duvidas">Dúvidas</a>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="p-section p-section--lilac">
    <div class="p-wrap">
      <header class="p-head revela"><p class="p-eye">#casasempelo</p><h2 class="p-title">Quem já usa</h2></header>
      <ul class="p-quotes">
        {
          quotes.map((item) => (
            <li class="revela">
              <span class="p-slot"><span>{item.slot}</span></span>
              <p>{item.text}</p>
              <strong>Nome · cidade</strong>
            </li>
          ))
        }
      </ul>
      <p class="p-quotes-note">Espaço reservado para depoimentos reais, com autorização dos clientes.</p>
    </div>
  </section>

  <section class="p-section" id="duvidas">
    <div class="p-wrap p-faq-grid">
      <header class="revela">
        <p class="p-eye">Antes de comprar</p>
        <h2 class="p-title">Dúvidas</h2>
        <p class="p-faq-sub">Não achou a sua? Pergunte no WhatsApp quando finalizar o pedido.</p>
      </header>
      <div class="p-faq">
        {
          faq.map(([question, answer]) => (
            <details class="revela">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <footer class="p-foot">
    <div class="p-wrap">
      <p class="p-foot-mark">Patota</p>
      <div class="p-foot-grid">
        <p>Para quem divide a casa com um pet e não quer dividir o sofá com o pelo dele.</p>
        <div><p>Seg. a sex., 9h às 18h</p><p>Pedidos pelo WhatsApp</p></div>
        <div><p><a href="#rolo">Rolo removedor</a></p><p><a href="#luva">Luva e mordedores</a></p><p><a href="#duvidas">Trocas e dúvidas</a></p></div>
      </div>
      <p class="p-legal">© {new Date().getFullYear()} Patota Pet · marca fictícia</p>
    </div>
  </footer>

  <PetArt />
</DemoFrame>

<script>
  const top = document.querySelector<HTMLElement>("[data-p-top]");
  const ribbon = document.querySelector<HTMLElement>(".demo-ribbon");
  const markTop = () => {
    top?.style.setProperty("--ribbon", `${Math.max(0, (ribbon?.offsetHeight ?? 0) - window.scrollY)}px`);
    top?.classList.toggle("is-scrolled", window.scrollY > 40);
  };
  window.addEventListener("scroll", markTop, { passive: true });
  markTop();

  const compare = document.querySelector<HTMLElement>("[data-ba-hint]");
  const range = compare?.querySelector<HTMLInputElement>("input[type=range]");
  if (compare && range && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        compare.classList.add("is-hint");
        const steps = [70, 30, 50];
        steps.forEach((value, index) => {
          window.setTimeout(() => {
            range.value = String(value);
            range.dispatchEvent(new Event("input"));
            if (index === steps.length - 1) window.setTimeout(() => compare.classList.remove("is-hint"), 900);
          }, 500 + index * 900);
        });
      },
      { threshold: 0.5 },
    );
    observer.observe(compare);
  }

  const revealed = document.querySelectorAll<HTMLElement>(".revela");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-on");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
    );
    revealed.forEach((element) => observer.observe(element));
  } else {
    revealed.forEach((element) => element.classList.add("is-on"));
  }
</script>

<style is:global>
  body.pet {
    --d-bg: #fcfbff;
    --d-surface: #ffffff;
    --d-ink: #15101f;
    --d-mute: #625b78;
    --d-line: #e6e0f5;
    --d-accent: #6a2cf0;
    --d-accent-ink: #ffffff;
    background: #fcfbff;
    color: #15101f;
    font-family: "Outfit", var(--font-sans);
  }
</style>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Gabarito:wght@800;900&family=Figtree:wght@400;600;700&family=Outfit:wght@400;500;600;700&display=swap");


  .p-wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .p-top {
    position: fixed;
    top: calc(var(--ribbon, 2rem) + 12px);
    right: 12px;
    left: 12px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem clamp(1rem, 2.4vw, 2rem);
    border-radius: 22px;
    color: #fff;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease),
      padding 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .p-top.is-scrolled {
    top: 12px;
    padding-block: 0.7rem;
    background: rgba(252, 251, 255, 0.9);
    box-shadow:
      0 0 0 1px #e6e0f5,
      0 12px 30px -18px rgba(21, 16, 31, 0.35);
    color: #15101f;
    backdrop-filter: blur(12px) saturate(1.4);
  }

  .p-logo {
    display: inline-flex;
    align-items: center;
    font-family: "Bagel Fat One", "Outfit", sans-serif;
    text-decoration: none;
  }

  .p-logo-bubble {
    position: relative;
    z-index: 1;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: #fff;
    color: #15101f;
    font-size: 1.05rem;
    line-height: 1;
  }

  .p-logo-bubble::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 10px;
    width: 14px;
    height: 12px;
    background: #fff;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .p-top.is-scrolled .p-logo-bubble {
    box-shadow: inset 0 0 0 1.5px #15101f;
  }

  .p-logo-tag {
    margin-left: -6px;
    padding: 0.4rem 0.7rem 0.4rem 1rem;
    border: 1.5px solid #15101f;
    border-radius: 0 999px 999px 0;
    background: #d7ff3a;
    color: #15101f;
    font-size: 0.85rem;
    line-height: 1;
  }

  .p-menu {
    display: flex;
    gap: 1.6rem;
  }

  .p-menu a {
    color: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    opacity: 0.9;
  }

  .p-menu a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .p-bag {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px currentColor;
    color: inherit;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
  }

  .p-bag:hover {
    background: #d7ff3a;
    box-shadow: none;
    color: #15101f;
  }

  .p-bag b {
    display: grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: #d7ff3a;
    color: #15101f;
    font-size: 0.72rem;
  }

  .p-hero {
    padding: 12px;
    font-family: "Figtree", "Outfit", sans-serif;
  }

  .p-panel {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100svh - 24px);
    padding: 7rem clamp(1rem, 3vw, 2rem) 9rem;
    overflow: clip;
    border-radius: 30px;
    background: #6a2cf0;
    color: #fff;
  }

  .p-panel::before {
    content: "";
    position: absolute;
    inset: 6.2rem clamp(1rem, 2.4vw, 2rem) clamp(1rem, 2.4vw, 2rem);
    z-index: -1;
    border: 1px solid rgba(255, 255, 255, 0.11);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.11) 1px, transparent 1px);
    background-position: center top;
    background-size: 64px 64px;
  }

  .p-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 60% at 70% 30%, rgba(255, 255, 255, 0.12), transparent 70%);
  }

  .p-hero-title {
    margin: 0;
