        {
          casa ? (
            <img src={casa} alt="Pessoa no sofá com o gato no colo" loading="lazy" />
          ) : (
            <svg viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <rect width="1200" height="420" fill="#efe6ff" />
              <rect x="0" y="0" width="1200" height="260" fill="#f6f0ff" />
              <rect x="820" y="40" width="250" height="190" rx="10" fill="#d9c9ff" />
              <rect x="840" y="60" width="210" height="150" rx="6" fill="#bfe3ff" />
              <path d="M840 160c60-40 120-20 210-60v110H840Z" fill="#8fd0a4" />
              <ellipse cx="560" cy="398" rx="420" ry="20" fill="#2a1d48" opacity="0.15" />
              <rect x="190" y="220" width="740" height="150" rx="40" fill="#f3ece0" />
              <rect x="220" y="160" width="680" height="110" rx="40" fill="#f8f3ea" />
              <rect x="160" y="230" width="90" height="140" rx="36" fill="#ece3d4" />
              <rect x="870" y="230" width="90" height="140" rx="36" fill="#ece3d4" />
              <rect x="420" y="190" width="160" height="90" rx="30" fill="#6a2cf0" opacity="0.85" />
              <path d="M650 250c0-40 40-62 80-50l14-26 10 30c34 12 44 52 20 76-30 26-120 22-124-30Z" fill="#2b2333" />
              <path d="M700 196l6-30 20 24M752 196l14-26 4 30" fill="#2b2333" />
              <circle cx="716" cy="216" r="4" fill="#d7ff3a" />
              <circle cx="746" cy="214" r="4" fill="#d7ff3a" />
              <path d="M640 290c-50 0-70 30-40 40" stroke="#2b2333" stroke-width="12" fill="none" stroke-linecap="round" />
            </svg>
          )
        }
        <div class="p-band-text">
          <p class="p-eye p-eye--light">Mais da casa sem pelo</p>
          <h2 class="p-title p-title--light">Para o pet e a lavanderia</h2>
        </div>
      </div>

      <div class="p-stack">
        {
          products.map((product, index) => (
            <article class:list={["p-pd", "revela", { "p-pd--flip": index % 2 === 1 }]} id={product.id}>
              <button class="p-pd-photo" type="button" data-add={product.id} aria-label={`Escolher ${product.name}`}>
                {photo(`${product.id}.jpg`) ? (
                  <img src={photo(`${product.id}.jpg`)} alt={product.name} loading="lazy" />
                ) : (
                  <svg viewBox="0 0 200 200" aria-hidden="true"><use href={`#art-${product.id}`} /></svg>
                )}
