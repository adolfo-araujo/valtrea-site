---
import { existsSync } from "node:fs";
import { join } from "node:path";
import DemoFrame from "../../components/demo/DemoFrame.astro";
import PetArt from "../../components/demo/PetArt.astro";

const money = (value: number) => new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(value);
const pix = (value: number) => money(Math.round(value * 90) / 100);
const photo = (name: string) => (existsSync(join(process.cwd(), "public", "demo", "pet", name)) ? `/demo/pet/${name}` : "");

const roller = { id: "rolo", name: "Rolo removedor reutilizável", price: 59.9 };
const products = [
  { id: "luva", eye: "Para o pet", name: "Luva de escovação", text: "Passa a mão na roupa ou no pet e o pelo vem junto. Pega o pelo curto e duro que fica preso na malha.", chips: ["Roupa preta", "Escova o pet", "Corino: use úmida"], price: 34.9, sizes: false },
  { id: "coletor", eye: "Lavanderia", name: "Coletor para máquina · 2 un.", text: "Vai junto com a roupa na máquina e segura o pelo que ela ia espalhar de volta.", chips: ["2 unidades", "Serve na secadora", "Reutilizável"], price: 29.9, sizes: false },
  { id: "osso", eye: "Para o pet", name: "Mordedor bio osso", text: "Mordedor em formato de osso para cães: distrai, ajuda na ansiedade e protege os móveis.", chips: ["Para cães", "Ansiedade", "Salva o sofá"], price: 59.9, sizes: false },
  { id: "madeira", eye: "Para o pet", name: "Mordedor de madeira de café", text: "Galho natural de madeira de café para o cão roer. Não lasca como galho comum.", chips: ["100% natural", "Dura mais", "P, M, G e GG"], price: 59.9, sizes: true },
];
const store = {
  products: [roller, ...products].map((item) => ({ id: item.id, name: item.name, price: item.price, ...("sizes" in item && item.sizes ? { options: ["porte"] } : {}) })),
  groups: [{ id: "porte", label: "Tamanho", type: "single" as const, required: true, choices: ["P", "M", "G", "GG"].map((label) => ({ label })) }],
  modes: ["envio"] as "envio"[],
  shipping: 14.9,
  freeFrom: 120,
  payments: ["Pix (10% off)", "Cartão em até 3x sem juros"],
};
const faq = [
  ["Como funciona o pedido?", "Você coloca os produtos na sacola e toca em finalizar. Aparece o pedido pronto para mandar no WhatsApp; a loja confirma o endereço e o frete, você paga no Pix ou no cartão e recebe com rastreio."],
  ["Precisa fazer força para tirar o pelo?", "Não. É vai e volta, com a mão leve. O pelo fica no compartimento do rolo."],
  ["Funciona com pelo curto de gato e cachorro SRD?", "Sim, foi pensado para isso. O pelo curto e duro é o que mais gruda na trama, e é onde o rolo e a luva juntos fazem diferença."],
  ["Funciona em sofá de corino ou couro?", "No corino o rolo não é a melhor opção. Use a luva levemente úmida: o pelo sai fácil e não risca."],
  ["Quanto tempo demora para chegar?", "Enviamos em até 24h úteis. O prazo de entrega depende do seu CEP e aparece antes de você pagar."],
  ["E se eu não gostar?", "Você tem 7 dias para trocar ou devolver. É só chamar no WhatsApp."],
];
const quotes = [
  { slot: "foto do cliente com o pet", text: "“Espaço para um depoimento real do cliente, com o nome do pet e o tipo de sofá.”" },
  { slot: "print da conversa", text: "“Espaço para um depoimento real. Ideal mencionar a roupa preta ou a máquina.”" },
  { slot: "foto do sofá depois", text: "“Espaço para um depoimento real do cliente.”" },
];
let seed = 11;
const random = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};
const hairs = Array.from({ length: 260 }, () => {
  const x = 40 + random() * 520;
  const y = 150 + random() * 250;
  const angle = random() * Math.PI;
  const length = 6 + random() * 9;
  return { x1: x, y1: y, x2: x + Math.cos(angle) * length, y2: y + Math.sin(angle) * length, light: random() > 0.35 };
});
const casa = photo("casa.jpg");
---

<DemoFrame
  brand="Patota Pet"
  title="Patota Pet · removedores de pelo de gato e cachorro (demonstração)"
  description="Loja de demonstração feita pela Valtrea: rolo, luva e coletor de pelo, mordedores e pedido pelo WhatsApp."
  path="/demo/pet"
  themeColor="#6A2CF0"
  bodyClass="pet"
  store={store}
>
  <header class="p-top" data-p-top>
    <a class="p-logo" href="#topo" aria-label="Página inicial">
      <span class="p-logo-bubble">Patota</span><span class="p-logo-tag">pet</span>
    </a>
    <nav class="p-menu" aria-label="Seções da loja">
      <a href="#rolo">Rolo</a>
      <a href="#luva">Luva</a>
      <a href="#coletor">Coletor</a>
      <a href="#osso">Mordedores</a>
    </nav>
    <button class="p-bag" type="button" data-bag-open>Sacola <b data-bag-count hidden>0</b></button>
  </header>

  <section class="p-hero" id="topo">
    <div class="p-panel">
      <h1 class="p-hero-title" aria-label="Sem pelo no sofá, na roupa">
