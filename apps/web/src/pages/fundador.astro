---
import { business } from "../config/business";
import { company, socialUrl } from "../config/company";
import Layout from "../layouts/Layout.astro";

const materials = [
  { name: "Material 1 · nome a definir", text: "Uma frase sobre o que a pessoa recebe.", tone: "#1f3d14", best: false },
  { name: "Material 2 · nome a definir", text: "Uma frase sobre o que a pessoa recebe.", tone: "#111116", best: true },
  { name: "Material 3 · nome a definir", text: "Uma frase sobre o que a pessoa recebe.", tone: "#3a2a1a", best: false },
  { name: "Material 4 · nome a definir", text: "Uma frase sobre o que a pessoa recebe.", tone: "#20304a", best: false },
];
const standards = [
  { title: "Não uso IA para escrever o conteúdo", text: "A IA ajuda no processo, mas o conteúdo é escrito por mim." },
  { title: "Direto ao ponto", text: "Nada de encher página. Você lê, aplica e vê resultado." },
  { title: "7 dias de garantia", text: "Não gostou? Peça o reembolso em até 7 dias, sem precisar explicar." },
];
const socials = (["instagram", "tiktok", "youtube"] as const).map((network) => ({ network, href: socialUrl(network) })).filter((item) => item.href);
const socialNames: Record<string, string> = { instagram: "Instagram", tiktok: "TikTok", youtube: "YouTube" };
const fonts = "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap";
const firstName = company.person.fullName.split(" ").slice(-1)[0]?.toLowerCase() ?? "adolfo";
const bars = [34, 52, 41, 66, 58, 79, 72, 94];
---

<Layout locale="pt" path="/fundador" title={`eu sou ${firstName} · fundador solo`} description="Materiais e parcerias do fundador da Valtrea." noindex themeColor="#ffffff" bodyClass="founder">
  <link slot="head" rel="stylesheet" href={fonts} />
  <script slot="head" is:inline>document.documentElement.classList.add("js");</script>

  <a class="f-skip" href="#materiais">Pular para os materiais</a>

  <header class="f-hero">
    <div class="f-collage">
      <div class="f-col f-col--left">
        <figure class="f-obj f-obj--mac" style="--r: -6deg; --i: 1"><img src="/fundador/macbook.webp" alt="" width="900" height="639" /></figure>
        <figure class="f-obj" style="--r: -4deg; --i: 3"><img src="/fundador/cafe.webp" alt="" width="396" height="371" /></figure>
      </div>

      <div class="f-center">
        <figure class="f-obj f-obj--top f-obj--wide" style="--r: -2deg; --i: 2">
          <div class="f-dash" aria-label="Painel de exemplo, com números ilustrativos">
            <div class="f-dash-head">
              <span><i></i><i></i><i></i></span>
              <small>Exemplo ilustrativo · não são resultados reais</small>
            </div>
            <div class="f-dash-body">
              <div>
                <small>Lucro total</small>
                <strong>R$ 48.000</strong>
                <em>+110% no mês</em>
              </div>
              <svg viewBox="0 0 160 70" aria-hidden="true">
                {bars.map((height, index) => <rect x={index * 20 + 4} y={70 - height * 0.68} width="12" height={height * 0.68} rx="3" />)}
              </svg>
            </div>
          </div>
        </figure>
        <h1 class="f-lockup">
          <span class="lk-serif f-in" style="--i: 1">eu sou</span>
          <span class="lk-big f-in" style="--i: 2">{firstName}</span>
          <span class="lk-box">fundador solo</span>
        </h1>
        <p class="f-sub f-in" style="--i: 4">Uma pessoa só dá conta de tantas operações?</p>
        <div class="f-ctas f-in" style="--i: 5">
          <a class="f-btn f-btn--full" href="#conjunto" data-open-hook>Opere junto comigo</a>
          <a class="f-btn" href="#materiais">Ver os materiais</a>
        </div>
      </div>

      <div class="f-col f-col--right">
        <figure class="f-obj" style="--r: 6deg; --i: 2"><img src="/fundador/celular.webp" alt="" width="367" height="655" /></figure>
        <figure class="f-obj" style="--r: 8deg; --i: 4"><img src="/fundador/airpods.webp" alt="" width="501" height="581" /></figure>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="f-section" id="materiais" aria-labelledby="t-materiais">
      <div class="f-wrap">
        <h2 class="f-title revela" id="t-materiais">
          <span class="lk-serif">aqui temos</span>
          <span class="lk-mid">os principais materiais</span>
        </h2>
        <ul class="f-catalog">
          {
            materials.map((item) => (
              <li class="revela">
                <div class="f-card">
                  {item.best && <span class="f-seal">Mais vendido</span>}
                  <div class="f-card-img">
                    <span class="f-book" style={`--tone: ${item.tone}`}>
                      <b>{item.name.split(" · ")[0]}</b>
                      <i>em breve</i>
                    </span>
                  </div>
                  <strong>{item.name}</strong>
                  <p>{item.text}</p>
                  <span class="f-see">
                    Em breve
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="f-section f-together" id="conjunto">
      <div class="f-wrap">
        <button class="f-hook revela" type="button" aria-expanded="false" aria-controls="formas" data-hook>
          <span class="lk-serif">quer lucrar</span>
          <span class="lk-mid">junto comigo?</span>
          <span class="lk-box lk-box--mid">sem curso</span>
          <span class="f-hook-sub">Você não compra aula. Recebe o produto pronto e já vende.</span>
          <span class="f-hook-open"><span>Olha só as formas</span><span class="f-plus" aria-hidden="true"></span></span>
        </button>

        <div class="f-ways-wrap" id="formas" hidden data-hook-panel>
          <div class="f-models">
            {
              business.explainers.map((item, index) => (
                <p>
                  <span class:list={["f-model", { "f-model--own": index === 1 }]}>{item.tag}</span>
                  <span>{item.text}</span>
                </p>
              ))
            }
          </div>
          <p class="f-phone">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5"></rect><path d="M10.5 18.5h3"></path></svg>
            <span>Se você tem celular, isso vai acelerar o seu processo em 200%</span>
          </p>
          <div class="f-ways" data-ways>
            {
              business.plans.map((plan, index) => (
                <article class:list={["f-way", { "f-way--featured": index === 1 }]}>
                  <div class="f-way-top">
                    <small class="f-label">{plan.kicker}</small>
                    <span class:list={["f-model", { "f-model--own": plan.tag !== "comissão" }]}>{plan.tag}</span>
                  </div>
                  <h3>{plan.name}</h3>
                  <div class="f-gain">
                    <small>{plan.gainLabel}</small>
                    <strong>{plan.gain}</strong>
                  </div>
                  <small class="f-receives">O que você recebe</small>
                  <ul class="f-list">
                    {plan.receives.map((line) => <li>{line}</li>)}
                  </ul>
                  <p class="f-price">
                    <small>{plan.note}</small>
                    {plan.installments && <span class="f-px">{plan.installments}</span>}
                    {plan.price}
                  </p>
                  <a class:list={["f-btn", "f-btn--wide", index === 1 ? "f-btn--white" : "f-btn--full"]} href={`/business?plano=${plan.id}#entrar`}>{plan.cta}</a>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="f-section" aria-labelledby="t-padrao">
      <div class="f-wrap f-standard-grid">
        <h2 class="f-title revela" id="t-padrao">
          <span class="lk-serif">vale para todos,</span>
          <span class="lk-mid">o meu padrão de produtos</span>
        </h2>
        <div class="f-standard">
          <div class="f-prism-stage revela" data-cube tabindex="0" role="group" aria-roledescription="carrossel" aria-label="O meu padrão de produtos. Use as setas para girar.">
            <ol class="f-prism">
              {
                standards.map((item, index) => (
                  <li class="f-prism-face" data-face={index} data-label={`${index + 1} de ${standards.length}: ${item.title}`}>
                    <div class="f-prism-body">
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="f-prism-nav">
            <div class="f-prism-dots">
              {standards.map((item, index) => <button type="button" class="f-prism-dot" data-cube-dot aria-label={`${index + 1} de ${standards.length}: ${item.title}`} aria-current={index === 0 ? "true" : "false"} />)}
            </div>
            <p class="f-prism-hint" aria-hidden="true">Arraste para girar</p>
          </div>
          <p class="sr-only" aria-live="polite" data-cube-live></p>
        </div>
      </div>
    </section>

    <section class="f-section f-who" aria-labelledby="t-quem">
      <div class="f-wrap f-who-grid revela">
        <h2 class="f-title" id="t-quem">
          <span class="lk-serif">quem faz sou eu</span>
          <span class="lk-mid">oi, sou {company.person.fullName} e</span>
        </h2>
        <p class="f-who-text">Comecei construindo sites para pequenos negócios e percebi que o que faltava para muita gente não era ideia, era alguém que deixasse tudo pronto para vender. Hoje faço os meus próprios produtos e abro a operação para quem quer vender junto.</p>
      </div>
    </section>
  </main>

  <footer class="f-foot">
    <div class="f-wrap">
      <p class="f-foot-mark">{firstName}</p>
      <nav class="f-socials" aria-label="Redes sociais">
        {
          socials.map((item) => (
            <a href={item.href} rel="me noopener" target="_blank">
              {socialNames[item.network]}
            </a>
          ))
        }
      </nav>
      <small>© {new Date().getFullYear()} {company.domain} · <a href="/privacidade">Privacidade</a> · <a href="/termos">Termos</a></small>
    </div>
  </footer>

  <script>
    import "../scripts/founder";
  </script>
</Layout>

<style is:global>
  body.founder {
    background: #fff;
    color: #0a0a0a;
  }
</style>

<style>
  .f-skip {
    position: absolute;
    top: -4rem;
    left: 1rem;
    z-index: 20;
    padding: 0.6rem 1rem;
    border-radius: 0.6rem;
    background: #0a0a0a;
    color: #fff;
    text-decoration: none;
  }

  .f-skip:focus {
    top: 1rem;
  }

  .f-wrap {
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .lk-serif {
    display: block;
    font-family: "Instrument Serif", Georgia, serif;
    font-size: clamp(1.6rem, 4.2vw, 2.6rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .lk-big {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 13vw, 8.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }

  .lk-mid {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .lk-box {
    position: relative;
    display: inline-block;
    isolation: isolate;
    margin-top: 0.5rem;
    padding: 0.18em 0.4em 0.24em;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.6vw, 2.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .lk-box::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #0a0a0a;
    transform: scaleX(0);
    transform-origin: left;
  }

  .lk-box--mid {
    margin-top: 0.35rem;
    font-size: clamp(2.2rem, 6vw, 3.8rem);
  }

  .f-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.5rem;
    border: 1px solid #0a0a0a;
    border-radius: 999px;
    background: #fff;
    color: #0a0a0a;
    font: 500 0.95rem/1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease),
      transform 0.35s var(--ease);
  }

  .f-btn:hover {
    background: #0a0a0a;
    color: #fff;
  }

  .f-btn:active {
    transform: scale(0.98);
  }

  .f-btn--full {
    background: #0a0a0a;
    color: #fff;
  }

  .f-btn--full:hover {
    background: #333;
    border-color: #333;
  }

  .f-btn--white {
    background: #fff;
    border-color: #fff;
    color: #0a0a0a;
  }

  .f-btn--white:hover {
    background: #ddd;
    border-color: #ddd;
    color: #0a0a0a;
  }

  .f-btn--wide {
    width: 100%;
  }

  .f-hero {
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: 4.5rem 1.25rem 3rem;
  }

  .f-collage {
    display: grid;
    grid-template-columns: 1fr minmax(0, 40rem) 1fr;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
  }

  .f-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .f-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .f-lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .f-sub {
    max-width: 30rem;
    margin: 0;
    color: #6b6b6b;
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
  }

  .f-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .f-obj {
    --s: clamp(5.5rem, 11vw, 9.5rem);
    display: grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    margin: 0;
    opacity: 0;
    transform: translateY(18px) scale(0.94);
    animation: f-enter 1s var(--ease) forwards;
    animation-delay: calc(300ms + var(--i, 0) * 90ms);
  }

  .f-obj:not(.f-obj--mac, .f-obj--wide) {
    position: relative;
  }

  .f-obj:not(.f-obj--mac, .f-obj--wide) img {
    position: absolute;
    inset: 0;
  }

  .f-obj img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: rotate(var(--r, 0deg));
  }

  .f-obj--mac {
    width: clamp(7rem, 14vw, 12rem);
    height: auto;
  }

  .f-obj--mac img {
    height: auto;
  }

  .f-obj--wide {
    width: clamp(14rem, 30vw, 24rem);
    height: auto;
  }

  .f-dash {
    width: 100%;
    overflow: hidden;
    border: 1px solid #e4e4e4;
    border-radius: 0.9rem;
    background: #fff;
    box-shadow: 0 18px 30px -24px rgba(0, 0, 0, 0.35);
    text-align: left;
    transform: rotate(var(--r, 0deg));
  }

  .f-dash-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid #efefef;
    background: #fafafa;
  }

  .f-dash-head span {
    display: flex;
    gap: 0.25rem;
  }

  .f-dash-head i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #dcdcdc;
  }

  .f-dash-head small {
    color: #8a8a8a;
    font-size: 0.6rem;
    font-weight: 500;
  }

  .f-dash-body {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: end;
    gap: 0.8rem;
    padding: 0.8rem 0.9rem 0.9rem;
  }

  .f-dash-body small {
    display: block;
    color: #6b6b6b;
    font-size: 0.68rem;
  }

  .f-dash-body strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .f-dash-body em {
    color: #387a1e;
    font-size: 0.66rem;
    font-style: normal;
    font-weight: 600;
  }

  .f-dash-body svg {
    width: 100%;
    height: auto;
    fill: #0a0a0a;
  }

  .f-dash-body rect:last-child {
    fill: #387a1e;
  }

  .f-in {
    opacity: 0;
    transform: translateY(14px);
    animation: f-enter 0.9s var(--ease) forwards;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  .f-lockup .lk-box {
    opacity: 0;
    animation: f-show 0.01s linear 0.55s forwards;
  }

  .f-lockup .lk-box::before {
    animation: f-strike 0.7s var(--ease) 0.45s forwards;
  }

  @keyframes f-enter {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes f-show {
    to {
      opacity: 1;
    }
  }

  @keyframes f-strike {
    to {
      transform: scaleX(1);
    }
  }

  .f-section {
    padding: clamp(4.5rem, 10vw, 7.5rem) 0;
  }

  .f-title {
    margin: 0 0 clamp(2rem, 5vw, 3.5rem);
  }

  :global(.js) .revela {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
    transition-delay: var(--d, 0ms);
  }

  :global(.js) .revela.is-on {
    opacity: 1;
    transform: none;
  }

  .f-title .lk-box::before,
  .f-hook .lk-box::before {
    transition: transform 0.8s var(--ease) 0.25s;
  }

  .f-hook.is-on .lk-box::before {
    transform: scaleX(1);
  }

  .f-catalog {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .f-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1rem 1rem 1.25rem;
    border: 1px solid #e4e4e4;
    border-radius: 1.4rem;
    transition: border-color 0.35s var(--ease);
  }

  .f-card:hover {
    border-color: #0a0a0a;
  }

  .f-card-img {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3.4;
    margin-bottom: 0.85rem;
    overflow: hidden;
    border-radius: 1rem;
    background: #f5f5f5;
  }

  .f-book {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 46%;
    aspect-ratio: 0.7;
    padding: 0.7rem 0.6rem;
    border-radius: 3px 8px 8px 3px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.16) 0 5%, transparent 5% 8%, rgba(0, 0, 0, 0) 8%), var(--tone);
    box-shadow:
      inset 3px 0 0 rgba(0, 0, 0, 0.25),
      0 12px 14px rgba(0, 0, 0, 0.18);
    color: #fff;
    transition: transform 0.5s var(--ease);
  }

  .f-book b {
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    line-height: 1.05;
  }

  .f-book i {
    color: rgba(255, 255, 255, 0.7);
    font-family: "Instrument Serif", Georgia, serif;
    font-size: 0.85rem;
  }

  .f-card:hover .f-book {
    transform: translateY(-6px) rotate(-2deg);
  }

  .f-card strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .f-card p {
    margin: 0;
    color: #6b6b6b;
    font-size: 0.92rem;
  }

  .f-see {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .f-see svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s var(--ease);
  }

  .f-card:hover .f-see svg {
    transform: translateX(4px);
  }

  .f-seal {
    position: absolute;
    top: 1.6rem;
    left: 1.6rem;
    z-index: 1;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    background: #0a0a0a;
    color: #fff;
    font: 600 0.75rem/1 var(--font-sans);
  }

  .f-together {
    border-top: 1px solid #e4e4e4;
    border-bottom: 1px solid #e4e4e4;
  }

  .f-hook {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
  }

  .f-hook:focus-visible {
    outline: 2px solid #0a0a0a;
    outline-offset: 8px;
