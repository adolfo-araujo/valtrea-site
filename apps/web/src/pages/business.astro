---
import Plans from "../components/business/Plans.astro";
import Icon from "../components/site/Icon.astro";
import { business } from "../config/business";
import { company, hasWhatsapp, quoteMailto, socialUrl } from "../config/company";
import Layout from "../layouts/Layout.astro";

const socials = (["instagram", "tiktok", "youtube"] as const).map((network) => ({ network, href: socialUrl(network) })).filter((item) => item.href);
const socialNames: Record<string, string> = { instagram: "Instagram", tiktok: "TikTok", youtube: "YouTube" };
const whatsapp = hasWhatsapp() ? company.whatsapp : "";
const year = new Date().getFullYear();
const mascot = ["...GGGG...", "..GGGGGG..", ".GWKGGWKG.", ".GWWGGWWG.", ".GGGGGGGG.", ".GGGDDGGG.", "..GGGGGG..", ".G.G..G.G.", ".G......G."];
const mascotColors: Record<string, string> = { G: "#387a1e", W: "#ffffff", K: "#111116", D: "#1f4a10" };
const mascotPixels = mascot.flatMap((row, y) => [...row].flatMap((cell, x) => (cell === "." ? [] : [{ x, y, fill: mascotColors[cell] ?? "#387a1e", eye: cell === "K" }])));
const trails = [
  { dx: -2.8, o: 0.38 },
  { dx: -1.45, o: 0.5 },
  { dx: 1.25, o: 0.5 },
  { dx: 2.45, o: 0.38 },
];
const serif = "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap";
import { legalIdentity } from "../config/legal";
---

<Layout locale="pt" path="/business" title="Valtrea Business" description={business.tagline} noindex themeColor="#ffffff" bodyClass="biz">
  <link slot="head" rel="stylesheet" href={serif} />
  <script slot="head" is:inline>document.documentElement.classList.add("js");</script>
  <header class="b-nav" data-biz-nav>
    <div class="b-wrap b-nav-inner">
      <a class="b-brand" href="/business">valtrea <em>business</em></a>
      <nav aria-label="Seções">
        <a href="#porque">Por que entrar</a>
        <a href="#produtos">Produtos</a>
        <a href="#planos">Planos</a>
      </nav>
      <a class="b-btn b-btn--dark b-btn--sm" href="#entrar">Quero entrar</a>
    </div>
  </header>

  <main id="main">
    <section class="b-hero">
      <div class="b-v" data-b-mark aria-hidden="true">
        <span class="b-stage">
          <span class="b-letter" data-b-letter>V</span>
          <svg class="b-critter" data-b-critter viewBox="0 0 10 9" shape-rendering="crispEdges">
            <defs>
              <filter id="b-mblur" x="-80%" y="-20%" width="260%" height="140%"><feGaussianBlur stdDeviation="0.75 0" /><feColorMatrix type="saturate" values="0" /></filter>
              <g id="b-mascot-shape">{mascotPixels.map((pixel) => <rect x={pixel.x} y={pixel.y} width="1" height="1" fill={pixel.fill} class={pixel.eye ? "b-critter-eye" : undefined} />)}</g>
            </defs>
            <g class="b-critter-run">
              {trails.map((trail, index) => <use href="#b-mascot-shape" class="b-critter-trail" filter="url(#b-mblur)" style={`--dx: ${trail.dx}px; --o: ${trail.o}; --i: ${index + 1}`} />)}
              <g class="b-critter-hop"><use href="#b-mascot-shape" /></g>
            </g>
          </svg>
        </span>
      </div>
      <h1 class="b-name b-in" style="--i: 6">valtrea <span>business</span></h1>
      <p class="b-headline b-in" style="--i: 8">{business.headline.split("&")[0]}<em>&amp;</em>{business.headline.split("&")[1]}</p>
      <div class="b-actions b-in" style="--i: 9">
        <a class="b-btn b-btn--dark b-btn--lg" href="#entrar">Quero entrar</a>
        <a class="b-btn b-btn--lg" href="#porque">Por que entrar?</a>
      </div>
    </section>

    <section class="b-section" id="porque">
      <div class="b-wrap">
        <h2 class="b-split revela"><em>por que deixamos</em><span>você entrar?</span></h2>
        <div class="b-why">
          <div class="b-why-card revela">
            <svg class="b-ring" viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="60" r="50" class="b-ring-track"></circle>
              <circle cx="60" cy="60" r="50" class="b-ring-fill" pathLength="100"></circle>
              <text x="60" y="73" text-anchor="middle">%</text>
            </svg>
            <div>
              <h3>{business.why.title}</h3>
              <p>{business.why.text}</p>
            </div>
          </div>
          <div class="b-why-grid">
            {
              business.why.cards.map((card) => (
                <article class="revela">
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </article>
              ))
            }
          </div>
          <a class="b-btn b-btn--dark b-btn--lg b-center" href="#entrar">{business.why.cta}</a>
        </div>
      </div>
    </section>

    <section class="b-section b-section--soft" id="produtos">
      <div class="b-wrap">
        <h2 class="b-split revela"><em>tudo o que</em><span>a gente vende</span></h2>
        <div class="b-products">
          {
            business.products.map((product) => (
              <article class="b-product revela">
                <div class="b-cover" style={`--h: ${product.hue}`}>
                  {product.badge && <span class="b-badge">{product.badge}</span>}
                  <span class="b-cover-kind">{product.kind}</span>
                </div>
                <h3>{product.name}</h3>
                <p>{product.price}</p>
              </article>
            ))
          }
        </div>
        <h3 class="b-sub revela">E o que vai junto</h3>
        <ul class="b-extras">
          {
            business.extras.map((extra) => (
              <li class="revela">
                <span>{extra.kind}</span>
                <strong>{extra.name}</strong>
                <b>{extra.price}</b>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Plans />

    <section class="b-section b-entrar" id="entrar">
      <div class="b-wrap b-entrar-grid">
        <div class="b-entrar-txt">
          <h2 class="b-split revela"><em>a equipe</em><span>está aberta</span></h2>
          <p class="b-form-sub revela">Deixe aqui as suas informações para que a equipe te avalie. A gente lê cada inscrição e responde pelo WhatsApp.</p>
        </div>

        <div class="b-form-wrap revela">
          <form class="b-form" data-apply data-whatsapp={whatsapp} data-email={company.email} data-subject="Inscrição Valtrea Business" novalidate>
            <div class="b-form-top">
              <strong>Quem é você?</strong>
            </div>

            <div class="b-fields">
              <label class="b-field b-field--full" data-field="name">
                <span>Nome</span>
                <input name="name" required maxlength="80" autocomplete="name" />
                <em class="b-error" hidden>Escreva o seu nome</em>
              </label>
              <label class="b-field" data-field="phone">
                <span>WhatsApp</span>
                <input name="phone" type="tel" required inputmode="tel" maxlength="20" autocomplete="tel" placeholder="(21) 90000-0000" />
                <em class="b-error" hidden>Confira o número com DDD</em>
              </label>
              <label class="b-field" data-field="email">
                <span>E-mail <i>opcional</i></span>
                <input name="email" type="email" maxlength="120" autocomplete="email" />
                <em class="b-error" hidden>Esse e-mail parece errado</em>
              </label>
              <label class="b-field">
                <span>Instagram ou TikTok <i>opcional</i></span>
                <input name="social" maxlength="60" placeholder="@seuperfil" autocapitalize="off" />
              </label>
              <label class="b-field">
                <span>Cidade / estado</span>
                <input name="city" maxlength="60" autocomplete="address-level2" placeholder="Rio de Janeiro/RJ" />
              </label>
              <label class="b-field b-field--full">
                <span>Plano</span>
                <select name="plan">{business.plans.map((plan) => <option>{plan.name}</option>)}</select>
              </label>
            </div>

            <fieldset class="b-group" data-field="experience">
              <legend>Você já vendeu na internet?</legend>
              <div class="b-pills">
                {["Nunca", "Já vendi algo", "Tenho operação rodando"].map((option) => <label><input type="radio" name="experience" value={option} /><span>{option}</span></label>)}
              </div>
              <em class="b-error" hidden>Escolha uma opção</em>
            </fieldset>

            <fieldset class="b-group" data-field="time">
              <legend>Quanto tempo por dia você tem?</legend>
              <div class="b-pills">
                {["Até 1h", "2 a 4h", "O dia todo"].map((option) => <label><input type="radio" name="time" value={option} /><span>{option}</span></label>)}
              </div>
              <em class="b-error" hidden>Escolha uma opção</em>
            </fieldset>

            <label class="b-field b-field--full" data-field="why">
              <span>Por que você?</span>
              <textarea name="why" required rows="4" maxlength="800" placeholder="Conte quem é o seu público e como pretende divulgar."></textarea>
              <em class="b-error" hidden>Escreva um pouco mais (pelo menos uma frase)</em>
            </label>

            <label class="b-consent" data-field="consent">
              <input type="checkbox" name="consent" />
              <span>Autorizo a Valtrea a guardar estes dados para avaliar a minha inscrição e falar comigo, como descrito na <a href="/privacidade" target="_blank" rel="noopener">Política de Privacidade</a>. Posso retirar a autorização quando quiser.</span>
            </label>
            <em class="b-error b-error-consent" hidden>Precisa marcar para a gente poder te chamar</em>

            <button type="submit" class="b-btn b-btn--dark b-btn--wide">Mandar minha inscrição</button>
          </form>

          <div class="b-ok" hidden tabindex="-1" data-apply-ok>
            <svg viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24"></circle><path d="m15 27 7 7 15-16"></path></svg>
            <strong>Inscrição pronta</strong>
            <p>A sua mensagem abriu para enviar. Se tiver a ver, a gente te chama no WhatsApp.</p>
            <a class="b-btn" href="#produtos">Enquanto isso, ver os produtos</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="b-foot">
    <p class="b-giant" aria-hidden="true">valtrea</p>
    <nav class="b-foot-links" aria-label="Redes">
      {
        socials.map((item) => (
          <a href={item.href} target="_blank" rel="noopener">
            {socialNames[item.network]}
          </a>
        ))
      }
      <a href={quoteMailto("Valtrea Business")}>E-mail</a>
      <a href="/privacidade">Privacidade</a>
      <a href="/termos">Termos de uso</a>
    </nav>
    <p class="b-copy">© {year} {legalIdentity("pt")}</p>
  </footer>
  <script>
    import "../scripts/business";
  </script>
</Layout>

<style is:global>
  body.biz {
    background: #fff;
  }
</style>

<style>
  .b-wrap {
    width: min(100% - 2.5rem, 68rem);
    margin: 0 auto;
  }

  .b-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.82);
    border-bottom: 1px solid transparent;
    transition: border-color 0.35s var(--ease);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .b-nav.is-scrolled {
    border-color: var(--line);
  }

  .b-nav-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.2rem;
  }

  .b-brand {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .b-brand em {
    color: #6b6e76;
    font-family: "Instrument Serif", Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .b-nav nav {
    display: flex;
    gap: 2rem;
    margin-left: auto;
  }

  .b-nav nav a {
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 500;
    text-decoration: none;
  }

  .b-nav nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .b-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.5rem;
    border: 1.5px solid var(--text);
    border-radius: 999px;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s var(--ease);
  }

  .b-btn:hover {
    transform: translateY(-2px);
  }

  .b-btn--dark {
    background: var(--text);
    color: #fff;
  }

  .b-btn--sm {
    padding: 0.6rem 1.2rem;
    font-size: 0.95rem;
  }

  .b-btn--lg {
    padding: 1.05rem 2rem;
    font-size: 1.15rem;
  }

  .b-center {
    justify-self: center;
  }

  .b-hero {
    display: grid;
    justify-items: center;
    padding: 4rem 1.25rem 5rem;
    text-align: center;
    overflow: hidden;
  }








  .b-v {
    position: relative;
    display: grid;
    place-items: center;
    width: min(88vw, 34rem);
    cursor: default;
  }

  .b-stage {
    position: relative;
    display: inline-block;
    color: #0a0a0a;
    font-family: var(--font-display);
    font-size: min(60vw, 24rem);
    font-weight: 800;
    line-height: 0.82;
  }

  .b-letter {
    position: relative;
    display: inline-block;
  }

  .b-critter {
    position: absolute;
    top: var(--critter-top, 0.02em);
    left: var(--critter-left, 0.5em);
    width: var(--critter-w, 0.16em);
    height: auto;
    overflow: visible;
  }

  .b-critter-run {
    animation: b-run 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .b-critter-trail {
    opacity: var(--o);
    transform: translateX(var(--dx));
    animation: b-trail 1.3s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.2s + var(--i) * 40ms);
  }

  .b-critter-hop {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .b-critter-eye {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: b-blink 4.5s 2.2s infinite;
  }

  @media (hover: hover) {
    .b-v:hover .b-critter-hop {
      animation: b-hop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
    }
  }

  @keyframes b-run {
    from {
      opacity: 0;
      transform: translateX(-14px);
    }
    25% {
      opacity: 1;
    }
  }

  @keyframes b-trail {
    from {
      opacity: 0;
      transform: translateX(calc(var(--dx) - 6px));
    }
    35% {
      opacity: calc(var(--o) * 1.6);
    }
    to {
      opacity: var(--o);
      transform: translateX(var(--dx));
    }
  }

  @keyframes b-blink {
    0%,
    92%,
    100% {
      transform: none;
    }
    95% {
      transform: scaleY(0.1);
    }
  }

  @keyframes b-hop {
    40% {
      transform: translateY(-2.5px);
    }
  }

  .b-in {
    opacity: 0;
    transform: translateY(14px);
    animation: b-enter 0.9s var(--ease) forwards;
    animation-delay: calc(var(--i, 0) * 90ms);
  }





  @keyframes b-enter {
    to {
      opacity: 1;
      transform: none;
    }
  }

  :global(.js) .revela {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
    transition-delay: var(--d, 0ms);
  }

  :global(.js) .revela.is-on {
    opacity: 1;
    transform: none;
  }








  .b-name {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 1.5rem;
    font-size: clamp(2.4rem, 7vw, 4rem);
    letter-spacing: -0.04em;
  }

  .b-name span {
    padding: 0 0.3rem;
    background: var(--text);
    color: #fff;
  }

  .b-headline {
    margin: 1.4rem 0 2.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5.5vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .b-headline em {
    padding: 0 0.15em;
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
  }

  .b-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }

  .b-section {
    padding: 5rem 0;
  }

  .b-section--soft {
    background: #f6f7f8;
  }

  .b-section h2 {
    margin-bottom: 2rem;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
  }

  .b-split {
    display: grid;
    line-height: 1;
  }

  .b-section .b-split {
    margin-bottom: 3rem;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
  }

  .b-split em {
    font-family: "Instrument Serif", Georgia, serif;
    font-size: 0.72em;
    font-weight: 400;
    letter-spacing: 0;
  }

  .b-split--center {
    justify-items: center;
    text-align: center;
  }

  .b-split mark {
    margin-top: 0.4rem;
    padding: 0.1em 0.35em 0.15em;
    background: var(--text);
    color: #fff;
  }

  .b-why {
    display: grid;
  }

  .b-why-card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.8rem, 5vw, 3.5rem);
    border-radius: 28px;
    background: #0b0b0d;
    color: #fff;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }

  .b-why-card h3 {
    color: #fff;
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
  }

  .b-why-card p {
    max-width: 34rem;
    margin: 0.8rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.1rem;
  }

  .b-ring {
    width: clamp(6rem, 14vw, 9rem);
  }

  .b-ring circle {
    fill: none;
    stroke-width: 10;
  }

  .b-ring-track {
    stroke: rgba(255, 255, 255, 0.14);
  }

  .b-ring-fill {
    stroke: #fff;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transform: rotate(-90deg);
    transform-origin: center;
    transition: stroke-dashoffset 1.6s var(--ease) 0.35s;
  }

  .b-why-card.is-on .b-ring-fill {
    stroke-dashoffset: 22;
  }

  .b-ring text {
    fill: #fff;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
  }

  .b-why-grid {
    --wire: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin: var(--wire) 0 2.6rem;
  }

  .b-why-grid article {
    position: relative;
    min-height: 12rem;
    padding: 1.9rem 1.6rem 1.7rem;
    border: 1px solid #dcdcdc;
    border-radius: 6px;
    background:
      radial-gradient(circle at 50% 50%, #8a8a8a 0 2px, #cfcfcf 2.5px 3.5px, transparent 4px) 22% 7px / 9px 9px no-repeat,
      radial-gradient(circle at 50% 50%, #8a8a8a 0 2px, #cfcfcf 2.5px 3.5px, transparent 4px) 78% 7px / 9px 9px no-repeat,
      linear-gradient(#fbfbfb, #f1f1f1);
    box-shadow:
      inset 0 1px 0 #fff,
      0 18px 30px -22px rgba(0, 0, 0, 0.35);
    transform-origin: 50% calc(var(--wire) * -1);
  }

  .b-why-grid article::before,
  .b-why-grid article::after {
    content: "";
    position: absolute;
    bottom: calc(100% - 11px);
    width: 2px;
    height: calc(var(--wire) + 13px);
    border-radius: 1px;
    background: linear-gradient(#0a0a0a, #555);
  }

  .b-why-grid article::before {
    left: calc((100% - 9px) * 0.22 + 3.5px);
  }

  .b-why-grid article::after {
    left: calc((100% - 9px) * 0.78 + 3.5px);
  }

  .b-why-grid article.is-on {
    animation: b-swing 2.2s var(--ease) both;
    animation-delay: calc(var(--d, 0ms) + 150ms);
  }

  @media (hover: hover) {
    .b-why-grid article.is-on:hover {
      animation: b-wiggle 1.4s var(--ease);
    }
  }

  @keyframes b-swing {
    0% {
      rotate: 4deg;
    }
    22% {
      rotate: -2.6deg;
    }
    44% {
      rotate: 1.5deg;
    }
    64% {
      rotate: -0.8deg;
    }
    82% {
      rotate: 0.3deg;
    }
    100% {
      rotate: 0deg;
    }
  }

  @keyframes b-wiggle {
    0%,
    100% {
      rotate: 0deg;
    }
    25% {
      rotate: 1.4deg;
    }
    55% {
      rotate: -0.9deg;
    }
    80% {
      rotate: 0.3deg;
    }
  }

  .b-why-card {
    position: relative;
    z-index: 1;
  }

  .b-why-grid h3 {
    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }

  .b-why-grid p {
    margin: 0.6rem 0 0;
    color: var(--text-soft);
  }

  .b-products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }

  .b-product h3 {
    margin: 0.7rem 0 0.2rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .b-product p {
    margin: 0;
